    log:
        os.path.join(OUTDIR, "log/ntmut_fitness_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ntmut_fitness.py"


rule aggregate_ntmut_fitness:
    """Aggregate nucleotide fitness across all clades."""
    input:
        fitness_files=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "fitness/ntmut_fitness/{clade}_ntmut_fitness.csv"),
            wc, extra_clades=["all"]
        )
    output:
        csv=os.path.join(OUTDIR, "fitness/ntmut_fitness_aggregated.csv")
    log:
        os.path.join(OUTDIR, "log/aggregate_ntmut_fitness.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_ntmut_fitness.py"


