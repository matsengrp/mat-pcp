# =============================================================================
# Stage 2: Clade Processing and PCP Extraction
# =============================================================================

checkpoint get_clades:
    """Identify clades with adequate sample counts for processing."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        clade_counts=os.path.join(OUTDIR, "mat/clade_counts.csv")
    log:
        os.path.join(OUTDIR, "log/get_clades.log")
    params:
        min_clade_size=config.get("min_clade_size", 100),
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting clade counts from metadata..."
            zcat {input.metadata} | \
            awk -F'\\t' 'NR==1 {{for(i=1;i<=NF;i++) if($i=="{params.clade_column}") col=i}}
                        NR>1 && col {{print $col}}' | \
            sort | uniq -c | \
            awk -v min={params.min_clade_size} 'BEGIN {{print "{params.clade_column},count,adequate_sample_counts"}}
                 {{gsub(/^ +/, "", $0); split($0, a, " ");
                   adequate=(a[1]>=min?"true":"false");
                   print a[2]","a[1]","adequate}}' > {output.clade_counts}

            echo "Clade counts summary:"
            cat {output.clade_counts}
            echo ""
            echo "Clades with adequate counts (>= {params.min_clade_size}):"
            grep ",true" {output.clade_counts} | wc -l
        ) > {log} 2>&1
        """


def clades_w_adequate_counts(wildcards):
    """
    Get list of clades with adequate sample counts for a given tree.

    This function is used with Snakemake checkpoints to dynamically determine
    which clades have enough samples for analysis. It resolves the checkpoint
    per tree via ``wildcards.tree``; ``clade_column``/``clades_to_exclude``/
    ``max_clades`` are read from the global config (they are not per-tree).
    """
    checkpoint_output = checkpoints.get_clades.get(tree=wildcards.tree).output.clade_counts
    clades_df = pd.read_csv(checkpoint_output)
    clade_col = config.get("clade_column", "Nextstrain_clade")
    clades = clades_df[clades_df['adequate_sample_counts'] == True][clade_col].tolist()
    clades_to_exclude = config.get("clades_to_exclude", [])
    clades = [clade for clade in clades if clade not in clades_to_exclude and pd.notna(clade)]
    # Limit number of clades for faster testing (set max_clades in config)
    max_clades = config.get("max_clades", None)
    if max_clades is not None and max_clades > 0:
        clades = clades[:max_clades]
    return clades


def per_clade_inputs(path_template, wildcards, extra_clades=()):
    """Expand ``path_template`` over this tree's adequate-count clades.

    ``path_template`` carries both the ``{tree}`` and ``{clade}`` wildcards
    (e.g. ``os.path.join(OUTDIR, "pcps/{clade}_pcps.csv.gz")`` or
    ``CLADE_FOUNDER_FASTA``). Used in ``input:`` lambdas of the aggregate
    rules so every per-clade fan-out resolves the checkpoint the same way.
    ``extra_clades`` appends non-checkpoint clades such as ``"all"``.
    """
    return expand(
        path_template,
        tree=wildcards.tree,
        clade=clades_w_adequate_counts(wildcards) + list(extra_clades),
    )


rule samples_by_clade:
    """Extract sample names for a specific clade."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        samples=os.path.join(OUTDIR, "mat/clades/{clade}_samples.txt")
    log:
        os.path.join(OUTDIR, "log/samples_by_clade_{clade}.log")
    params:
        clade="{clade}",
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting samples for clade: {params.clade}"
            zcat {input.metadata} | \
            awk -F'\\t' -v clade="{params.clade}" \
            'NR==1 {{for(i=1;i<=NF;i++) {{if($i=="strain") strcol=i; if($i=="{params.clade_column}") cladecol=i}}}}
             NR>1 && $cladecol ~ "^"clade"( |$)" {{print $strcol}}' > {output.samples}

            echo "Found $(wc -l < {output.samples}) samples for clade {params.clade}"
        ) > {log} 2>&1
        """


rule mat_clade_subset:
    """Extract mutation-annotated tree for a specific clade."""
    input:
        tree=get_final_tree(),
        samples=rules.samples_by_clade.output.samples
    output:
        tree=os.path.join(OUTDIR, "mat/clades/{clade}_tree.pb")
    threads: get_threads("mat_clade_subset")
    resources:
        mem_mb=8000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/mat_clade_subset_{clade}.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/mat_clade_subset_{clade}.stderr"),
        stdout=os.path.join(OUTDIR, "log/mat_clade_subset_{clade}.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting clade subtree for {wildcards.clade}..." > {log.stdout}
        echo "Input tree: {input.tree}" >> {log.stdout}
        echo "Samples file: {input.samples}" >> {log.stdout}
        echo "Sample count: $(wc -l < {input.samples})" >> {log.stdout}

        (
            matUtils extract \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Clade subtree created: {output.tree}" >> {log.stdout}
        """


rule extract_pcps_by_clade:
    """Extract and curate parent-child pairs from a clade-specific tree.

    Drops branches whose parent/child are identical within the gene-region
    slice in the same pass that constructs them. Emits both the curated PCP
    table and a per-clade list of identical-slice branch IDs (consumed by
    `count_mutations_clade` to harmonize mutation counting).
    """
    input:
        tree=rules.mat_clade_subset.output.tree,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        clade_founder_fasta=CLADE_FOUNDER_FASTA,
        coding_sites=rules.ref_coding_sites.output.csv
    output:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{clade}_pcps.csv.gz"),
        filtered_branches=os.path.join(OUTDIR, "pcps/{gene}/{clade}_filtered_branches.csv")
    params:
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"],
        max_reversions_to_clade_founder=config["max_reversions_to_clade_founder"],
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    threads: get_threads("extract_pcps")
    resources:
        mem_mb=8000,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/extract_pcps_{gene}_{clade}.tsv")
    log:
        os.path.join(OUTDIR, "log/extract_pcps_{gene}_{clade}.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/pcp_from_tree.py"


