# =============================================================================
# Stage 8: Validation - PCP vs Mutation Count Consistency
# =============================================================================

rule extract_mutations_from_pcps:
    """Extract AA mutation counts from PCPs by translating sequences."""
    input:
        pcps=rules.aggregate_clade_pcps.output.all_pcps,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta
    output:
        aa_counts=os.path.join(config["output_dir"], "validation/pcp_aa_counts.csv")
    params:
        pcp_gene_region=config.get("pcp_gene_region", None),
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"]
    log:
        os.path.join(config["output_dir"], "log/extract_mutations_from_pcps.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/extract_mutations_from_pcps.py"


rule validate_pcp_vs_counts:
    """Validate PCP-derived AA counts match aamut_fitness actual_count."""
    input:
        pcp_counts=rules.extract_mutations_from_pcps.output.aa_counts,
        aamut_fitness_files=lambda wc: expand(
            os.path.join(config["output_dir"], "aamut_fitness/{clade}_aamut_fitness.csv"),
            clade=clades_w_adequate_counts(wc)
        ),
        all_aamut_fitness=rules.aggregate_aamut_fitness.output.csv
    output:
        report=os.path.join(config["output_dir"], "validation/pcp_vs_counts_report.txt"),
        discrepancies=os.path.join(config["output_dir"], "validation/pcp_vs_counts_discrepancies.csv")
    params:
        pcp_gene_name=config.get("pcp_gene_region", {}).get("gene", None) if config.get("pcp_gene_region") else None
    log:
        os.path.join(config["output_dir"], "log/validate_pcp_vs_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/validate_pcp_vs_aamut.py"
