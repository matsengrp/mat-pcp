rule translate_mat:
    """Get translated mutations from MAT for each clade."""
    input:
        mat=rules.mat_clade_subset.output.tree,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        ref_gtf=rules.edit_ref_gtf.output.gtf
    output:
        tsv=os.path.join(OUTDIR, "mutations/{clade}_mutations.tsv")
    log:
        os.path.join(OUTDIR, "log/translate_mat_{clade}.log")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Translating mutations for clade {wildcards.clade}..." > {log}
        matUtils summary \
            -i {input.mat} \
            -g {input.ref_gtf} \
            -f {input.ref_fasta} \
            -t {output.tsv} \
            2>> {log}
        echo "Output: $(wc -l < {output.tsv}) lines" >> {log}
        """


rule mat_sample_paths:
    """Get nucleotide mutation paths for samples in each clade."""
    input:
        mat=rules.mat_clade_subset.output.tree
