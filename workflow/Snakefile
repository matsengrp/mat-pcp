# =============================================================================
# Stage 8: Validation - PCP vs Mutation Count Consistency
# =============================================================================

rule extract_mutations_from_pcps:
    """Extract AA mutation counts from PCPs by translating sequences."""
    input:
        pcps=os.path.join(OUTDIR, "pcps/S/all_pcps.csv"),
        ref_fasta=rules.get_ref_fasta.output.ref_fasta
    output:
        aa_counts=os.path.join(OUTDIR, "validation/pcp_aa_counts.csv")
    params:
        # Validation is pinned to Spike until #109 generalizes it over pcp_genes.
        pcp_gene_region={"gene": "S"},
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"]
    log:
        os.path.join(OUTDIR, "log/extract_mutations_from_pcps.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/extract_mutations_from_pcps.py"


rule validate_pcp_vs_counts:
    """Validate PCP-derived AA counts match aamut_fitness actual_count."""
    input:
        pcp_counts=rules.extract_mutations_from_pcps.output.aa_counts,
        aamut_fitness_files=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "aamut_fitness/{clade}_aamut_fitness.csv"), wc
        ),
        all_aamut_fitness=rules.aggregate_aamut_fitness.output.csv
    output:
        report=os.path.join(OUTDIR, "validation/pcp_vs_counts_report.txt"),
        discrepancies=os.path.join(OUTDIR, "validation/pcp_vs_counts_discrepancies.csv")
    params:
        # Validation is pinned to Spike until #109 generalizes it over pcp_genes.
        pcp_gene_name="S"
    log:
        os.path.join(OUTDIR, "log/validate_pcp_vs_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/validate_pcp_vs_aamut.py"
