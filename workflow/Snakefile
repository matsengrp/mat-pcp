"""Top-level Snakemake file that runs the unified MAT pipeline."""

import os
import re
import pandas as pd
import yaml

# The pipeline is always run with exactly one explicit ``--configfile`` (e.g.
# ``--configfile config/config.yaml``). There is deliberately no ``configfile:``
# directive here: a default directive would always be loaded and Snakemake would
# deep-merge any ``--configfile`` on top of it, causing dict keys like ``trees``
# to *union* across configs rather than be replaced. Requiring a single explicit
# config keeps ``config["trees"]`` exactly what the user passed.


# =============================================================================
# Version Management
# =============================================================================

# Filename of the problematic-codon mask produced by ``rule
# get_problematic_sites`` and consumed by the DASM-ready filter rules (#80).
# Kept as a module-level constant so a rename is a one-line change; the
# rule itself is defined far below the consumers, which is why the
# consumers use a hardcoded path instead of ``rules.X.output.Y``.
SPIKE_MASK_FILENAME = "spike_codon_sites_to_mask.txt"

# Read pipeline version from VERSION file
VERSION_FILE = os.path.join(workflow.basedir, "..", "VERSION")
with open(VERSION_FILE) as f:
    PIPELINE_VERSION = f.read().strip()

# =============================================================================
# Tree Table and Output Directory Template
# =============================================================================
#
# The pipeline processes a mapping of named trees (``trees:`` in the config),
# building all of them in one Snakemake invocation. Each tree's label becomes a
# ``{tree}`` wildcard, so every output path lives under
# ``{output_root}/{tree}_{version}/...``. ``output_root`` defaults to
# ``results``. ``OUTDIR`` is a module-level template string carrying the
# ``{tree}`` placeholder; it is used everywhere an output/log/benchmark path is
# built, exactly like the ``{clade}`` wildcard used further down.

OUTPUT_ROOT = config.get("output_root", "results")
OUTDIR = os.path.join(OUTPUT_ROOT, f"{{tree}}_{PIPELINE_VERSION}")


def tree_outdir(label):
    """Resolve the concrete output directory for a given tree ``label``.

    Formats the ``{tree}`` placeholder in ``OUTDIR`` so this and ``OUTDIR``
    can never drift -- ``OUTDIR`` is the single source of truth for the
    output-dir shape.
    """
    return OUTDIR.format(tree=label)


# Valid tree-label characters. Single source of truth: used both to validate
# labels in ``_normalize_trees`` and as the ``tree`` wildcard constraint below.
TREE_LABEL_PATTERN = r"[A-Za-z0-9_.+-]+"

# Path template for a clade's whole-genome founder FASTA (produced by rule
# ``clade_founder_fasta``; consumed by ``extract_pcps_by_clade`` and
# ``clade_founder_nts``). Defined once so a path change tracks in one place --
# ``rules.clade_founder_fasta.output`` cannot be used at the
# ``extract_pcps_by_clade`` site because that rule is parsed later in the file.
CLADE_FOUNDER_FASTA = os.path.join(OUTDIR, "clade_founders/{clade}.fa")


def _normalize_trees(cfg):
    """Read and validate the ``trees:`` mapping from the config.

    Returns a dict keyed by tree label. Each value is the per-tree config with
    a fully resolved ``qc_filter_options`` block: the global block with
    ``max_leaf_date`` overridden by the tree's value when present. ``mat`` and
    ``metadata`` are required per tree; ``max_leaf_date`` is the only
    per-tree-overridable key and is optional -- when unset (globally and per
    tree) it resolves to ``None``, meaning no upper date cutoff.

    Validates each tree entry explicitly (label characters, allowed keys,
    required keys) rather than silently ignoring mistakes -- e.g. a misspelled
    ``max_leaf_dat`` would otherwise be swallowed and the tree would quietly
    inherit the global cutoff.
    """
    # ``TREE_LABEL_PATTERN`` is also the ``tree`` wildcard constraint below; a
    # label with any other character (e.g. a space or ``/``) would only fail
    # later with a confusing MissingInputException, so reject it up front.
    label_pattern = re.compile(TREE_LABEL_PATTERN)
    # Per-tree keys. REQUIRED_TREE_KEYS point at that tree's inputs;
    # QC_OVERRIDABLE_KEYS override a value *inside* qc_filter_options (see the
    # merge below). To add a second overridable key later, extend this tuple --
    # the merge and validation both iterate it, so nothing else needs touching.
    REQUIRED_TREE_KEYS = ("mat", "metadata")
    QC_OVERRIDABLE_KEYS = ("max_leaf_date",)
    allowed_keys = {*REQUIRED_TREE_KEYS, *QC_OVERRIDABLE_KEYS}

    trees = cfg.get("trees")
    if not trees:
        raise ValueError(
            "Config must define a top-level `trees:` mapping keyed by tree "
            "label, with `mat` and `metadata` per tree. Run with exactly one "
            "`--configfile` (e.g. --configfile config/config.yaml)."
        )

    global_qc = dict(cfg.get("qc_filter_options", {}))
    normalized = {}
    for label, entry in trees.items():
        if not label_pattern.fullmatch(str(label)):
            raise ValueError(
                f"Tree label '{label}' has invalid characters; allowed: "
                f"letters, digits, and '_.+-' (it becomes a directory name "
                f"and the '{{tree}}' wildcard)."
            )
        if not isinstance(entry, dict):
            raise ValueError(
                f"Tree '{label}' must be a mapping with `mat`/`metadata` keys, "
                f"got {type(entry).__name__}."
            )
        entry = dict(entry)
        unknown = set(entry) - allowed_keys
        if unknown:
            raise ValueError(
                f"Tree '{label}' has unexpected key(s) {sorted(unknown)}; "
                f"only {sorted(allowed_keys)} are per-tree settings (every "
                f"other setting is global)."
            )
        for required in REQUIRED_TREE_KEYS:
            if not entry.get(required):
                raise ValueError(
                    f"Tree '{label}' is missing required key '{required}'."
                )
        # Merge qc_filter_options: the global block, with each overridable key
        # replaced by this tree's value when present. The keys live *inside*
        # qc_filter_options (consumed by filter_metadata.py), so without this
        # merge every tree would silently share the global value. Each key is
        # optional: unset (or null) -> None, set explicitly so
        # filter_metadata.py always finds it (None means no cutoff).
        qc = dict(global_qc)
        for key in QC_OVERRIDABLE_KEYS:
            if key in entry:
                qc[key] = entry[key]
            qc.setdefault(key, None)
        entry["qc_filter_options"] = qc
        normalized[label] = entry
    return normalized


TREES = _normalize_trees(config)
TREE_LABELS = list(TREES)


def tree_cfg(label):
    """Return the normalized per-tree config for ``label``."""
    return TREES[label]


# =============================================================================
# Config Validation
# =============================================================================

# Required configuration parameters. ``mat``/``metadata`` are enforced per tree
# in ``_normalize_trees`` (above); ``output_dir`` no longer exists (it is derived
# from ``output_root`` + the ``{tree}`` label). The rest are global.
REQUIRED_CONFIG_PARAMS = [
    "clade_column",
    "ref_fasta",
    "ref_gtf",
    "max_nt_mutations",
    "max_reversions_to_ref",
    "site_include_range",
    "qc_filter_options",
    "min_clade_size",
    "pcp_genes",
]

# Parameters required for full pipeline (may not be present in test mode)
OPTIONAL_CONFIG_PARAMS = [
    "site_mask_vcf",
    "usher_masked_sites",
    "max_reversions_to_clade_founder",
    "clade_founders",
]

missing_params = [p for p in REQUIRED_CONFIG_PARAMS if p not in config]
if missing_params:
    raise ValueError(
        f"Missing required config parameters: {missing_params}\n"
        f"Please add these to your config.yaml file."
    )


# Soft warning: production configs (`config-public-*.yaml`) should generally
# run with `min_clade_size: 0` so the GLM rates table is estimated from every
# available clade, not just the largest ones. v1 production runs shipped with
# `min_clade_size: 10000` and biased the resulting rates.
def _warn_if_public_config_has_min_clade_size(workflow_obj, min_clade_size):
    if min_clade_size in (0, None):
        return
    configfiles = getattr(workflow_obj, "configfiles", []) or []
    public_configs = [
        cf for cf in configfiles
        if os.path.basename(cf).startswith("config-public-")
        and os.path.basename(cf).endswith(".yaml")
    ]
    if not public_configs:
        return
    names = ", ".join(os.path.basename(cf) for cf in public_configs)
    print(
        f"WARNING: min_clade_size={min_clade_size} in production config(s) "
        f"[{names}]. Set min_clade_size: 0 unless you specifically want to "
        f"drop small clades from the GLM rate estimation. See mat-pcp #81 "
        f"for context.",
        file=__import__("sys").stderr,
    )

_warn_if_public_config_has_min_clade_size(workflow, config.get("min_clade_size", 0))


# =============================================================================
# Wildcard Constraints
# =============================================================================

wildcard_constraints:
    clade="[A-Za-z0-9_.+-]+",  # Valid clade name characters
    tree=TREE_LABEL_PATTERN,   # Tree label (slash-free by construction)
    gene="[A-Za-z0-9_.+-]+",   # Gene symbol (a single path segment, slash-free)


# Disambiguate the aggregate rules from their per-clade counterparts. The
# aggregate outputs (``aggregated.csv``, ``all_pcps.csv``, ``all_*_dasm_*``,
# ``all_aamut_fitness.csv``) live in the same directory as a ``{clade}`` output
# and their filenames are valid ``{clade}`` matches (``clade=aggregated`` /
# ``clade=all``). Before the multi-tree refactor these aggregate paths were
# fully concrete strings, so Snakemake auto-preferred them over the wildcarded
# per-clade rules; now that every path carries the ``{tree}`` wildcard, that
# implicit tie-break is gone and we must state the preference explicitly.
ruleorder: aggregate_mutation_counts > count_mutations_clade
ruleorder: aggregate_clade_pcps > extract_pcps_by_clade
ruleorder: curate_all_pcps_for_dasm > curate_pcps_for_dasm
ruleorder: aggregate_aamut_fitness > aamut_fitness_by_clade


# =============================================================================
# Default Resources
# =============================================================================

# Default resource allocations (can be overridden per-rule)
default_resources = {
    "mem_mb": 4000,
    "runtime": 60,  # minutes
}


# =============================================================================
# Helper Functions
# =============================================================================

def get_threads(rule_name):
    """Get thread count for a rule from config with fallback to default."""
    if "threads" in config and rule_name in config["threads"]:
        return config["threads"][rule_name]
    elif "threads" in config and "default" in config["threads"]:
        return config["threads"]["default"]
    return 1


def get_final_tree():
    """Get the final tree path based on whether optimization is enabled.

    Returns a template carrying the ``{tree}`` placeholder (via ``OUTDIR``), so
    it resolves per tree when used as a rule input.
    """
    if config.get("optimize_tree", False):
        return os.path.join(OUTDIR, "mat/filtered_tree.pb")
    return os.path.join(OUTDIR, "mat/filtered_tree_raw.pb")


# =============================================================================
# Output Targets
# =============================================================================

# Proteins to generate PCPs and gene-sliced founder FASTAs for. A single
# Snakemake invocation fans PCP extraction over this list; coordinates come from
# the reference GTF (see ``cds_blocks_for_gene``). Output paths use the gene
# symbol verbatim (``pcps/S/``, ``clade_founders/S/``).
PCP_GENES = config["pcp_genes"]
if not PCP_GENES:
    raise ValueError(
        "config 'pcp_genes' must be a non-empty list of gene symbols "
        "(e.g. [S, ORF1ab, E]); got an empty list."
    )

# Terminal output files for the unified pipeline
# (intermediate files are created automatically as dependencies)
#
# Tree-only targets (fanned over ``tree`` in ``rule all``). The DASM-ready
# PCP targets are pinned to Spike (``pcps/S/``) until #108 generalizes them.
results_files = [
    "rates_table.csv",
    SPIKE_MASK_FILENAME,
    "fitness/ntmut_fitness_aggregated.csv",
    "aamut_fitness/all_aamut_fitness.csv",
    "validation/pcp_vs_counts_report.txt",
    # DASM-ready PCPs (#80): aggregate file + sentinel covering per-clade fan-out.
    "pcps/S/all_pcps_dasm_ready.csv",
    "pcps/S/dasm_ready_per_clade.done",
]

rule all:
    """Default target: produce all primary pipeline outputs for every tree."""
    input:
        expand(
            os.path.join(OUTDIR, "{f}"),
            tree=TREE_LABELS,
            f=results_files,
        ),
        # Per-gene PCP targets (tree x gene). The curation report pulls in each
        # gene's ``pcps/{gene}/all_pcps.csv`` (and thus the per-clade PCPs and
        # gene-sliced founders).
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/pcp_curation_report.txt"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene founder-slice collectors (tree x gene): each pulls in that
        # gene's ``clade_founders/{gene}/{clade}.fa`` slices for every clade.
        expand(
            os.path.join(OUTDIR, "clade_founders/{gene}/founders.done"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        )


# =============================================================================
# Stage 1: Data Acquisition and Filtering
# =============================================================================

rule link_inputs:
    """Create symlinks to input MAT tree and metadata files."""
    params:
        mat=lambda wc: tree_cfg(wc.tree)["mat"],
        metadata=lambda wc: tree_cfg(wc.tree)["metadata"],
        output_dir=lambda wc: tree_outdir(wc.tree),
    output:
        mat=os.path.join(OUTDIR, "mat/mat_tree.pb.gz"),
        metadata=os.path.join(OUTDIR, "mat/metadata.tsv.gz")
    log:
        os.path.join(OUTDIR, "log/link_inputs.log")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            mkdir -p {params.output_dir}/mat
            ln -sf $(realpath {params.mat}) {output.mat}
            ln -sf $(realpath {params.metadata}) {output.metadata}
        ) > {log} 2>&1
        """


rule filter_metadata:
    """Filter the metadata to remove invalid sequences based on QC criteria."""
    input:
        metadata=rules.link_inputs.output.metadata
    output:
        filtered_metadata=os.path.join(OUTDIR, "mat/filtered_metadata.tsv.gz")
    params:
        qc_filter_options=lambda wc: tree_cfg(wc.tree)["qc_filter_options"],
        subset_frac=config.get("subset_frac", 1.0),
        skip_qc_filtering=config.get("skip_qc_filtering", False),
    threads: get_threads("filter_metadata")
    log:
        invalid_strains=os.path.join(OUTDIR, "log/invalid_strains.txt")
    conda:
        "envs/default.yml"
    script:
        "scripts/filter_metadata.py"


rule filter_mat_tree:
    """Extract valid sequences from the MAT tree based on filtered metadata."""
    input:
        mat_tree=rules.link_inputs.output.mat,
        filtered_metadata=rules.filter_metadata.output.filtered_metadata
    output:
        filtered_pb=os.path.join(OUTDIR, "mat/filtered_tree_raw.pb")
    threads: get_threads("filter_mat_tree")
    resources:
        mem_mb=16000,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/filter_mat_tree.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/filter_mat_tree.stderr"),
        stdout=os.path.join(OUTDIR, "log/filter_mat_tree.stdout"),
        valid_strains=os.path.join(OUTDIR, "log/valid_strains.txt"),
    conda:
        "envs/usher.yml"
    params:
        mat_subset_kwargs=config.get("mat_subset_kwargs", "")
    shell:
        """
        # Extract strain names from filtered metadata
        zcat {input.filtered_metadata} | cut -f1 | sed 1,1d > {log.valid_strains}

        echo "Extracting $(wc -l < {log.valid_strains}) strains from MAT..." > {log.stdout}

        (
            # First extraction: filter to valid strains
            matUtils extract \
                -i {input.mat_tree} \
                -s {log.valid_strains} \
                -o {output.filtered_pb}

            # Second extraction: apply any additional subset kwargs
            # This addresses a known issue where double extraction is needed
            if [ -n "{params.mat_subset_kwargs}" ]; then
                matUtils extract \
                    -i {output.filtered_pb} \
                    {params.mat_subset_kwargs} \
                    -o {output.filtered_pb}
            fi
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Filtered tree created: {output.filtered_pb}" >> {log.stdout}
        """


rule optimize_mat_tree:
    """Optimize the filtered tree for maximum parsimony (conditional)."""
    input:
        tree=rules.filter_mat_tree.output.filtered_pb
    output:
        optimized_tree=os.path.join(OUTDIR, "mat/filtered_tree.pb")
    threads: get_threads("optimize_mat_tree")
    resources:
        mem_mb=32000,
        runtime=480
    benchmark:
        os.path.join(OUTDIR, "benchmarks/optimize_mat_tree.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/optimize_mat_tree.stderr"),
        stdout=os.path.join(OUTDIR, "log/optimize_mat_tree.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Optimizing tree with {threads} threads..." > {log.stdout}
        (
            matOptimize \
                -i {input.tree} \
                -o {output.optimized_tree} \
                -T {threads}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Optimized tree created: {output.optimized_tree}" >> {log.stdout}
        """


rule get_ref_fasta:
    """Download reference genome FASTA."""
    params:
        url=config["ref_fasta"],
    output:
        ref_fasta=os.path.join(OUTDIR, "ref/ref.fa"),
    log:
        os.path.join(OUTDIR, "log/get_ref_fasta.log")
    conda:
        "envs/default.yml"
    shell:
        """
        echo "Downloading reference FASTA from {params.url}" > {log}
        curl -L {params.url} 2>> {log} | gunzip -c > {output.ref_fasta}
        echo "Reference FASTA saved to {output.ref_fasta}" >> {log}
        echo "Sequence length: $(grep -v '>' {output.ref_fasta} | tr -d '\\n' | wc -c)" >> {log}
        """


rule get_ref_gtf:
    """Download reference genome GTF annotations."""
    params:
        url=config["ref_gtf"],
    output:
        ref_gtf=os.path.join(OUTDIR, "ref/original_ref.gtf"),
    log:
        os.path.join(OUTDIR, "log/get_ref_gtf.log")
    conda:
        "envs/default.yml"
    shell:
        """
        echo "Downloading reference GTF from {params.url}" > {log}
        curl -L {params.url} 2>> {log} | gunzip -c > {output.ref_gtf}
        echo "Reference GTF saved to {output.ref_gtf}" >> {log}
        echo "Gene count: $(grep -c 'gene_id' {output.ref_gtf})" >> {log}
        """


rule edit_ref_gtf:
    """Add missing gene annotations to GTF."""
    input:
        gtf=rules.get_ref_gtf.output.ref_gtf
    output:
        gtf=os.path.join(OUTDIR, "ref/edited_ref.gtf"),
    params:
        edits=config.get("add_to_ref_gtf", {}),
    log:
        os.path.join(OUTDIR, "log/edit_ref_gtf.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/edit_ref_gtf.py"


rule ref_coding_sites:
    """Map all genome sites to coding regions, codon positions, and genes."""
    input:
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
    output:
        csv=os.path.join(OUTDIR, "ref/coding_sites.csv"),
    threads: get_threads("ref_coding_sites")
    log:
        os.path.join(OUTDIR, "log/ref_coding_sites.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ref_coding_sites.py"


# =============================================================================
# Stage 2: Clade Processing and PCP Extraction
# =============================================================================

checkpoint get_clades:
    """Identify clades with adequate sample counts for processing."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        clade_counts=os.path.join(OUTDIR, "mat/clade_counts.csv")
    log:
        os.path.join(OUTDIR, "log/get_clades.log")
    params:
        min_clade_size=config.get("min_clade_size", 100),
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting clade counts from metadata..."
            zcat {input.metadata} | \
            awk -F'\\t' 'NR==1 {{for(i=1;i<=NF;i++) if($i=="{params.clade_column}") col=i}}
                        NR>1 && col {{print $col}}' | \
            sort | uniq -c | \
            awk -v min={params.min_clade_size} 'BEGIN {{print "{params.clade_column},count,adequate_sample_counts"}}
                 {{gsub(/^ +/, "", $0); split($0, a, " ");
                   adequate=(a[1]>=min?"true":"false");
                   print a[2]","a[1]","adequate}}' > {output.clade_counts}

            echo "Clade counts summary:"
            cat {output.clade_counts}
            echo ""
            echo "Clades with adequate counts (>= {params.min_clade_size}):"
            grep ",true" {output.clade_counts} | wc -l
        ) > {log} 2>&1
        """


def clades_w_adequate_counts(wildcards):
    """
    Get list of clades with adequate sample counts for a given tree.

    This function is used with Snakemake checkpoints to dynamically determine
    which clades have enough samples for analysis. It resolves the checkpoint
    per tree via ``wildcards.tree``; ``clade_column``/``clades_to_exclude``/
    ``max_clades`` are read from the global config (they are not per-tree).
    """
    checkpoint_output = checkpoints.get_clades.get(tree=wildcards.tree).output.clade_counts
    clades_df = pd.read_csv(checkpoint_output)
    clade_col = config.get("clade_column", "Nextstrain_clade")
    clades = clades_df[clades_df['adequate_sample_counts'] == True][clade_col].tolist()
    clades_to_exclude = config.get("clades_to_exclude", [])
    clades = [clade for clade in clades if clade not in clades_to_exclude and pd.notna(clade)]
    # Limit number of clades for faster testing (set max_clades in config)
    max_clades = config.get("max_clades", None)
    if max_clades is not None and max_clades > 0:
        clades = clades[:max_clades]
    return clades


def per_clade_inputs(path_template, wildcards, extra_clades=()):
    """Expand ``path_template`` over this tree's adequate-count clades.

    ``path_template`` carries both the ``{tree}`` and ``{clade}`` wildcards
    (e.g. ``os.path.join(OUTDIR, "pcps/{clade}_pcps.csv")`` or
    ``CLADE_FOUNDER_FASTA``). Used in ``input:`` lambdas of the aggregate
    rules so every per-clade fan-out resolves the checkpoint the same way.
    ``extra_clades`` appends non-checkpoint clades such as ``"all"``.
    """
    return expand(
        path_template,
        tree=wildcards.tree,
        clade=clades_w_adequate_counts(wildcards) + list(extra_clades),
    )


rule samples_by_clade:
    """Extract sample names for a specific clade."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        samples=os.path.join(OUTDIR, "mat/clades/{clade}_samples.txt")
    log:
        os.path.join(OUTDIR, "log/samples_by_clade_{clade}.log")
    params:
        clade="{clade}",
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting samples for clade: {params.clade}"
            zcat {input.metadata} | \
            awk -F'\\t' -v clade="{params.clade}" \
            'NR==1 {{for(i=1;i<=NF;i++) {{if($i=="strain") strcol=i; if($i=="{params.clade_column}") cladecol=i}}}}
             NR>1 && $cladecol ~ "^"clade"( |$)" {{print $strcol}}' > {output.samples}

            echo "Found $(wc -l < {output.samples}) samples for clade {params.clade}"
        ) > {log} 2>&1
        """


rule mat_clade_subset:
    """Extract mutation-annotated tree for a specific clade."""
    input:
        tree=get_final_tree(),
        samples=rules.samples_by_clade.output.samples
    output:
        tree=os.path.join(OUTDIR, "mat/clades/{clade}_tree.pb")
    threads: get_threads("mat_clade_subset")
    resources:
        mem_mb=8000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/mat_clade_subset_{clade}.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/mat_clade_subset_{clade}.stderr"),
        stdout=os.path.join(OUTDIR, "log/mat_clade_subset_{clade}.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting clade subtree for {wildcards.clade}..." > {log.stdout}
        echo "Input tree: {input.tree}" >> {log.stdout}
        echo "Samples file: {input.samples}" >> {log.stdout}
        echo "Sample count: $(wc -l < {input.samples})" >> {log.stdout}

        (
            matUtils extract \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Clade subtree created: {output.tree}" >> {log.stdout}
        """


rule extract_pcps_by_clade:
    """Extract and curate parent-child pairs from a clade-specific tree.

    Drops branches whose parent/child are identical within the gene-region
    slice in the same pass that constructs them. Emits both the curated PCP
    table and a per-clade list of identical-slice branch IDs (consumed by
    `count_mutations_clade` to harmonize mutation counting).
    """
    input:
        tree=rules.mat_clade_subset.output.tree,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        clade_founder_fasta=CLADE_FOUNDER_FASTA,
        coding_sites=rules.ref_coding_sites.output.csv
    output:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{clade}_pcps.csv"),
        filtered_branches=os.path.join(OUTDIR, "pcps/{gene}/{clade}_filtered_branches.csv")
    params:
        max_nt_mutations=config.get("pcp_max_nt_mutations", 4),
        max_reversions_to_ref=config.get("pcp_max_reversions_to_ref", 1),
        max_reversions_to_clade_founder=config.get("pcp_max_reversions_to_clade_founder", 1)
    threads: get_threads("extract_pcps")
    resources:
        mem_mb=8000,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/extract_pcps_{gene}_{clade}.tsv")
    log:
        os.path.join(OUTDIR, "log/extract_pcps_{gene}_{clade}.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/pcp_from_tree.py"


rule aggregate_clade_pcps:
    """Aggregate a gene's clade-specific PCPs into a single file."""
    input:
        pcps=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "pcps", wc.gene, "{clade}_pcps.csv"), wc
        )
    output:
        all_pcps=os.path.join(OUTDIR, "pcps/{gene}/all_pcps.csv")
    log:
        os.path.join(OUTDIR, "log/aggregate_clade_pcps_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_clade_pcps.py"


rule aggregate_filtered_branches:
    """Aggregate per-clade filtered branch IDs and create curation report."""
    input:
        curated_pcps=rules.aggregate_clade_pcps.output.all_pcps,
        filtered_branches=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "pcps", wc.gene, "{clade}_filtered_branches.csv"), wc
        )
    output:
        report=os.path.join(OUTDIR, "pcps/{gene}/pcp_curation_report.txt"),
        filtered_branches=os.path.join(OUTDIR, "pcps/{gene}/filtered_branch_ids.csv")
    log:
        os.path.join(OUTDIR, "log/aggregate_filtered_branches_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_filtered_branches.py"


# =============================================================================
# DASM-ready PCP curation
# =============================================================================
# These rules emit ``*_pcps_dasm_ready.csv`` siblings of the existing
# ``*_pcps.csv`` files. The filter set + train/val split mirrors
# ``dasm2 preprocess`` exactly (reimplemented in plain NumPy here so the
# rule can stay in ``envs/default.yml`` without pulling in torch/dasm2).
#
# Seed convention (mirrors ``data-central/scripts/filter_viral_pcps.sh``):
#   per-clade  -> seed=1729
#   aggregate  -> seed=42
# The aggregate's seed differs intentionally; it's a guardrail against
# accidentally producing the aggregate with the per-clade default.
#
# Once v2 ships, these outputs replace the post-hoc
# ``data-central/scripts/filter_viral_pcps.sh`` step.

rule curate_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to a single clade's PCPs.

    Pinned to Spike (``pcps/S/``) and the Spike codon mask until #108
    generalizes DASM-ready filtering to every configured protein.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/S/{clade}_pcps.csv"),
        mask_sites=os.path.join(OUTDIR, SPIKE_MASK_FILENAME)
    output:
        dasm_ready=os.path.join(OUTDIR, "pcps/S/{clade}_pcps_dasm_ready.csv"),
        report=os.path.join(OUTDIR, "pcps/S/{clade}_dasm_filter_report.txt"),
        stats=os.path.join(OUTDIR, "pcps/S/{clade}_dasm_filter_stats.json")
    params:
        seed=1729,
        val_fraction=0.10
    log:
        os.path.join(OUTDIR, "log/curate_pcps_for_dasm_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


rule curate_all_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to the all-clades aggregate.

    Uses a different seed (42) than the per-clade rule (1729) by repository
    convention; this matches ``filter_viral_pcps.sh``'s guardrail.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/S/all_pcps.csv"),
        mask_sites=os.path.join(OUTDIR, SPIKE_MASK_FILENAME)
    output:
        dasm_ready=os.path.join(OUTDIR, "pcps/S/all_pcps_dasm_ready.csv"),
        report=os.path.join(OUTDIR, "pcps/S/all_dasm_filter_report.txt"),
        stats=os.path.join(OUTDIR, "pcps/S/all_dasm_filter_stats.json")
    params:
        seed=42,
        val_fraction=0.10
    log:
        os.path.join(OUTDIR, "log/curate_all_pcps_for_dasm.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


def _dasm_ready_per_clade_outputs(wildcards):
    """Per-clade dasm-ready outputs (Spike) - fans out over clades_w_adequate_counts."""
    return expand(
        os.path.join(OUTDIR, "pcps/S/{clade}_pcps_dasm_ready.csv"),
        tree=wildcards.tree,
        clade=clades_w_adequate_counts(wildcards),
    )


rule dasm_ready_pcps_all_clades:
    """Collector target for the per-clade DASM-ready outputs.

    Aggregates the per-clade ``*_pcps_dasm_ready.csv`` files into a single
    "everything is built" signal so ``rule all`` can depend on one path.
    """
    input:
        _dasm_ready_per_clade_outputs
    output:
        sentinel=os.path.join(OUTDIR, "pcps/S/dasm_ready_per_clade.done")
    shell:
        "touch {output.sentinel}"


