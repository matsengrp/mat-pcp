        "scripts/ntmut_counts_by_clade.py"


rule ntmut_fitness_by_clade:
    """Compute probabilistic fitness estimates for nucleotide mutations per clade."""
    input:
        counts=rules.ntmut_counts_by_clade.output.csv
    output:
        csv=os.path.join(OUTDIR, "fitness/ntmut_fitness/{clade}_ntmut_fitness.csv")
    params:
        N_f=config.get("fitness_N_f", 300),
        N_n_exp=config.get("fitness_N_n_exp", 300)
    threads: get_threads("ntmut_fitness")
    resources:
        mem_mb=2000,
        runtime=30
    benchmark:
