# =============================================================================
# Clade-subsampling arms: the draw and its roster (#151)
# =============================================================================

rule subsample_clade_samples:
    """Draw one arm's subsample of one clade's sample list.

    The **only** rule an arm adds to the front of the pipeline: everything else
    an arm rebuilds is an existing rule reached through ``{arm_dir}``. That is
    deliberate -- ``mat/clades/{clade}_samples.txt`` is the single input
    determining a clade's subtree, so thinning it moves the counts arm and the
    PCP arm together and there is no second wiring to drift.

    Reads the already-written full list rather than re-deriving it from the
    metadata's clade column: ``samples_by_clade`` matches with the awk regex
    ``^clade( |$)`` against values like ``21L (Omicron)``, and a Python
    re-implementation would agree on ``19A`` and disagree on exactly the values
    that regex exists for.
    """
    input:
        samples=rules.samples_by_clade.output.samples
    output:
        samples=os.path.join(OUTDIR, "mat/clades/{arm}/{clade}_samples.txt")
    params:
        # The *spec*, not a resolved unit. A cap arm's unit is derived from the
        # clade sizes, and resolving a checkpoint inside ``params`` would tie
        # this rule's scheduling to one -- so the script decides membership from
        # the sample list it already reads (``len(samples) > cap``), which is the
        # same predicate ``resolve_unit`` applies to the checkpoint's counts.
        spec=lambda wc: dict(arm_spec_from_wildcards(wc))
    log:
        os.path.join(OUTDIR, "log/{arm}/subsample_clade_samples_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/subsample_clade_samples.py"


def arm_fitness_tables(wildcards):
    """Every arm's per-clade fitness table, plus the full-depth ones to compare.

    The full-depth side is requested for the arm's *whole* grid rather than for
    its unit, because non-unit clades are the control: an arm re-aggregates all
    of them and their effects must come out identical, so their rows are what
    show the arm did not reach a clade the config never named.
    """
    outdir = OUTDIR.format(tree=wildcards.tree)
    full = clades_w_adequate_counts(wildcards)
    retained = arm_retained_counts(wildcards)
    targets = []
    units = arm_units_for_tree(wildcards)
    for arm in SUBSAMPLE_ARMS:
        unit = set(units[arm])
        kept = retained[arm]
        # Mirrors ``arm_clades``: every clade the full tree processes except a
        # unit clade thinned below ``min_clade_size``. Spelled out rather than
        # calling it, since that helper reads ``wildcards.arm_dir`` and this rule
        # has no such wildcard -- it spans every arm at once.
        for clade in (c for c in full if c not in unit or c in kept):
            targets.append(
                os.path.join(outdir, "aamut_fitness", arm, f"{clade}_aamut_fitness.csv")
            )
            targets.append(
                os.path.join(outdir, "aamut_fitness", f"{clade}_aamut_fitness.csv")
            )
    return sorted(set(targets))


rule subsample_correlations:
    """Correlate each arm's per-clade fitness effects against full depth (#151).

    The headline result the arms exist to produce. One row per
    ``(arm, clade, estimator, population)``, always carrying the
    ``n_mutations`` the coefficient was computed on.

    The population is a **fixed ground-truth set defined on the full-depth
    row** -- ``max(actual_count, expected_count) >= subsample_count_threshold``
    at full depth -- so it is the same set of mutations at every sampling depth
    and the coefficients are comparable across arms. Two alternatives are both
    wrong and both look reasonable. Filtering on the *arm's* row is survivorship
    bias: it drops exactly the mutations the thinning destroyed, so the
    denominator moves with the cut and a degrading estimator reports a flat
    correlation. Correlating over the whole grid measures the grid: every row
    carries a ``delta_fitness_ratio`` even where nothing was observed (121,348
    of 121,427 rows for 20A on the test data) and those rows are invariant to
    sampling depth by construction.

    What the thinning cost is reported as ``count_fraction`` --
    ``sum(actual_count_arm) / sum(actual_count_full)`` over the whole grid. A
    fraction of *distinct scored mutations* is deliberately **not** also
    reported: counting mutations rather than observations treats one falling
    from 900 counts to 3 as fully retained, it diverges from the count fraction
    by up to 30x in practice (21J at cap 5,000: 0.0033 against 0.103), and it
    predicts the fitted slope worse (Spearman 0.940 against 0.985 over the 120
    completed cap fits). Shipping both would be shipping two retention
    fractions that differ threefold with no stated reason to prefer one.
    ``n_scored_full`` / ``n_scored_arm`` remain as the raw deletion counts.

    This is the arms' only summary file. Its inputs are the two fitness tables
    it correlates and nothing else, so requesting it does not pull in a clade's
    PCP extraction -- which for a cap arm would be 30 clades x 6 genes of work
    that has no bearing on a correlation between two tables.
    """
    input:
        fitness=arm_fitness_tables
    output:
        summary=os.path.join(OUTDIR, "correlation_summary.csv")
    params:
        roster=_arm_roster_param,
        outdir=lambda wc: OUTDIR.format(tree=wc.tree),
        count_threshold=config.get("subsample_count_threshold", 10)
    log:
        os.path.join(OUTDIR, "log/subsample_correlations.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/subsample_correlations.py"


# =============================================================================
# Stage 3a: Clade Founders
# =============================================================================

rule clade_founder_jsons:
    """Download clade founder JSON files from external sources."""
    params:
        neher_json=config["clade_founders"]["neher_json"],
        roemer_json=config["clade_founders"]["roemer_json"]
    output:
        neher_json=os.path.join(OUTDIR, "clade_founders/clade_founders_neher.json"),
        roemer_json=os.path.join(OUTDIR, "clade_founders/clade_founders_roemer.json")
    log:
        os.path.join(OUTDIR, "log/clade_founder_jsons.log")
    shell:
        """
        mkdir -p $(dirname {output.neher_json})
        echo "Downloading Neher clade founders..." > {log}
        curl -L {params.neher_json} > {output.neher_json} 2>> {log}
        echo "Downloading Roemer clade founders..." >> {log}
        curl -L {params.roemer_json} > {output.roemer_json} 2>> {log}
        echo "Done!" >> {log}
        """


rule clade_founder_fasta:
    """Generate the whole-genome founder FASTA for each clade.

    The per-gene, in-frame founder slices used as DASM wildtypes are produced
    separately by ``slice_founder_gene`` (which consumes this founder).
    """
    input:
        neher_json=rules.clade_founder_jsons.output.neher_json,
        roemer_json=rules.clade_founder_jsons.output.roemer_json,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta
    output:
        fasta=CLADE_FOUNDER_FASTA
    params:
        roemer_nextstrain_to_pango=config.get("roemer_nextstrain_to_pango", {}),
        reference_clade=config.get("reference_clade", "19A"),
        allow_reference_identical_founders=config.get(
            "allow_reference_identical_founders", []
        )
    log:
        os.path.join(OUTDIR, "log/clade_founder_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_founder_fasta.py"


# ---------------------------------------------------------------------------
# Gene-sliced founder FASTAs
# ---------------------------------------------------------------------------
#
# One in-frame founder slice is emitted per (gene, clade) at
# ``clade_founders/<gene>/<clade>.fa`` using the gene symbol verbatim. Each is
# sliced from that clade's whole-genome founder on the reference GTF's CDS
# blocks (via ``sequences.slice_cds``), so it byte-aligns with the PCP
# parent/child slices and can serve as the wildtype for training
# ParentIndependent DASM models. Fanning over a ``{gene}`` wildcard keeps the
# per-protein conditionality in the DAG rather than in a conditional output
# list on ``clade_founder_fasta`` (issue #95).

rule slice_founder_gene:
    """Slice one gene's in-frame CDS out of a clade's whole-genome founder."""
    input:
        fasta=rules.clade_founder_fasta.output.fasta,
        gtf=rules.edit_ref_gtf.output.gtf
    output:
        gene_fasta=GENE_FOUNDER_FASTA
    params:
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    log:
        os.path.join(OUTDIR, "log/slice_founder_gene_{gene}_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/slice_founder_gene.py"


def _gene_founder_slices(wildcards):
    """Every adequate-count clade's founder slice for one gene."""
    return per_clade_inputs(
        GENE_FOUNDER_FASTA.replace("{gene}", wildcards.gene), wildcards
    )


rule gene_founders_all_clades:
    """Collector target for one gene's per-clade founder slices.

    Aggregates every adequate-count clade's ``clade_founders/<gene>/<clade>.fa``
    into a single "everything is built" signal so ``rule all`` can depend on one
    path per gene.
    """
    input:
        _gene_founder_slices
    output:
        sentinel=os.path.join(OUTDIR, "clade_founders/{gene}/founders.done")
    shell:
        "touch {output.sentinel}"


