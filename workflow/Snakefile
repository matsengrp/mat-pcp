    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting sample paths for clade {wildcards.clade}..." > {log}
        matUtils extract -i {input.mat} -S {output.tsv} 2>> {log}
        echo "Output: $(wc -l < {output.tsv}) lines" >> {log}
        """


