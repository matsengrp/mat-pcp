"""Top-level Snakemake file that runs the unified MAT pipeline."""

import collections
import os
import re
import pandas as pd
import yaml
from importlib import util as importlib_util

# The pipeline is always run with exactly one explicit ``--configfile`` (e.g.
# ``--configfile config/config.yaml``). There is deliberately no ``configfile:``
# directive here: a default directive would always be loaded and Snakemake would
# deep-merge any ``--configfile`` on top of it, causing dict keys like ``trees``
# to *union* across configs rather than be replaced. Requiring a single explicit
# config keeps ``config["trees"]`` exactly what the user passed.


# =============================================================================
# Version Management
# =============================================================================

# Per-gene nucleotide masks are produced by ``rule masked_nt_sites`` (one per
# configured protein: ``pcps/<gene>/masked_nt_sites.csv``) and consumed by the
# per-gene DASM-ready filter rules (#80, generalized over ``pcp_genes`` in
# #108): each protein is filtered against its own mask. Through v12 that mask
# was ``<gene>_codon_sites_to_mask.txt``, the same clade-independent set widened
# to codons; #158 retired it, so the drop filter and DASM's loss now read one
# mask at one granularity.

# Read pipeline version from VERSION file
VERSION_FILE = os.path.join(workflow.basedir, "..", "VERSION")
with open(VERSION_FILE) as f:
    PIPELINE_VERSION = f.read().strip()

# =============================================================================
# Shared workflow modules needed at parse time
# =============================================================================
#
# The era partition (#137) is consulted while building the DAG -- which eras get
# a neutral-rate fit is decided from the clade list, not at run time -- so
# ``modules/era.py`` is imported here with the same by-path loader the scripts
# use (#111). Importing it rather than restating the era names keeps one
# definition of the partition: a second copy here is exactly how the
# ``roemer_nextstrain_to_pango`` per-config duplication produced #129.
_loader_spec = importlib_util.spec_from_file_location(
    "workflow_loader",
    os.path.join(workflow.basedir, "modules", "workflow_loader.py"),
)
_workflow_loader = importlib_util.module_from_spec(_loader_spec)
_loader_spec.loader.exec_module(_workflow_loader)
era_mod = _workflow_loader.load_workflow_module("era", workflow.basedir)
# ``modules/cutoffs.py`` is imported for the same reason: which (cutoff, clade)
# pairs get a truncated PCP set is a DAG-construction decision (#149), and the
# ``{cutoff}`` wildcard constraint is the module's own ``CUTOFF_PATTERN`` so the
# pattern that validates a configured cutoff and the pattern that matches it in a
# path cannot drift apart.
cutoffs_mod = _workflow_loader.load_workflow_module("cutoffs", workflow.basedir)
# ``modules/subsample.py``, for the same reason again (#151): the arm naming
# rule, the ``arm_dir`` wildcard pattern and the draw itself all have to agree
# between the DAG, the sampling script and the tests, and the way they stay
# agreed is that there is one copy.
subsample_mod = _workflow_loader.load_workflow_module("subsample", workflow.basedir)

# =============================================================================
# Tree Table and Output Directory Template
# =============================================================================
#
# The pipeline processes a mapping of named trees (``trees:`` in the config),
# building all of them in one Snakemake invocation. Each tree's label becomes a
# ``{tree}`` wildcard, so every output path lives under
# ``{output_root}/{tree}_{version}/...``. ``output_root`` defaults to
# ``results``. ``OUTDIR`` is a module-level template string carrying the
# ``{tree}`` placeholder; it is used everywhere an output/log/benchmark path is
# built, exactly like the ``{clade}`` wildcard used further down.

OUTPUT_ROOT = config.get("output_root", "results")
OUTDIR = os.path.join(OUTPUT_ROOT, f"{{tree}}_{PIPELINE_VERSION}")


def tree_outdir(label):
    """Resolve the concrete output directory for a given tree ``label``.

    Formats the ``{tree}`` placeholder in ``OUTDIR`` so this and ``OUTDIR``
    can never drift -- ``OUTDIR`` is the single source of truth for the
    output-dir shape.
    """
    return OUTDIR.format(tree=label)


# Valid tree-label characters. Single source of truth: used both to validate
# labels in ``_normalize_trees`` and as the ``tree`` wildcard constraint below.
TREE_LABEL_PATTERN = r"[A-Za-z0-9_.+-]+"

# Path template for a clade's whole-genome founder FASTA (produced by rule
# ``clade_founder_fasta``; consumed by ``extract_pcps_by_clade`` and
# ``clade_founder_nts``). Defined once so a path change tracks in one place --
# ``rules.clade_founder_fasta.output`` cannot be used at the
# ``extract_pcps_by_clade`` site because that rule is parsed later in the file.
CLADE_FOUNDER_FASTA = os.path.join(OUTDIR, "clade_founders/{clade}.fa")

# Same, for a clade's founder sliced down to one gene (produced by rule
# ``slice_founder_gene``; consumed by ``gene_founders_all_clades`` and
# ``censor_table``). Defined once for the same reason: three hand-built copies
# of this shape were one edit away from drifting apart.
GENE_FOUNDER_FASTA = os.path.join(OUTDIR, "clade_founders/{gene}/{clade}.fa")


def _normalize_trees(cfg):
    """Read and validate the ``trees:`` mapping from the config.

    Returns a dict keyed by tree label. Each value is the per-tree config with
    a fully resolved ``qc_filter_options`` block: the global block with
    ``max_leaf_date`` overridden by the tree's value when present. ``mat`` and
    ``metadata`` are required per tree; ``max_leaf_date`` is the only
    per-tree-overridable key and is optional -- when unset (globally and per
    tree) it resolves to ``None``, meaning no upper date cutoff.

    Validates each tree entry explicitly (label characters, allowed keys,
    required keys) rather than silently ignoring mistakes -- e.g. a misspelled
    ``max_leaf_dat`` would otherwise be swallowed and the tree would quietly
    inherit the global cutoff.
    """
    # ``TREE_LABEL_PATTERN`` is also the ``tree`` wildcard constraint below; a
    # label with any other character (e.g. a space or ``/``) would only fail
    # later with a confusing MissingInputException, so reject it up front.
    label_pattern = re.compile(TREE_LABEL_PATTERN)
    # Per-tree keys. REQUIRED_TREE_KEYS point at that tree's inputs;
    # QC_OVERRIDABLE_KEYS override a value *inside* qc_filter_options (see the
    # merge below). To add a second overridable key later, extend this tuple --
    # the merge and validation both iterate it, so nothing else needs touching.
    REQUIRED_TREE_KEYS = ("mat", "metadata")
    QC_OVERRIDABLE_KEYS = ("max_leaf_date",)
    # Overrides a *top-level* config key rather than one inside
    # qc_filter_options, so it is merged separately below. Per-tree because the
    # cutoffs a tree can carry are bounded by its own max_leaf_date (#149).
    TREE_OVERRIDABLE_KEYS = ("pcp_date_cutoffs",)
    allowed_keys = {
        *REQUIRED_TREE_KEYS,
        *QC_OVERRIDABLE_KEYS,
        *TREE_OVERRIDABLE_KEYS,
    }

    trees = cfg.get("trees")
    if not trees:
        raise ValueError(
            "Config must define a top-level `trees:` mapping keyed by tree "
            "label, with `mat` and `metadata` per tree. Run with exactly one "
            "`--configfile` (e.g. --configfile config/config.yaml)."
        )

    global_qc = dict(cfg.get("qc_filter_options", {}))
    normalized = {}
    for label, entry in trees.items():
        if not label_pattern.fullmatch(str(label)):
            raise ValueError(
                f"Tree label '{label}' has invalid characters; allowed: "
                f"letters, digits, and '_.+-' (it becomes a directory name "
                f"and the '{{tree}}' wildcard)."
            )
        if not isinstance(entry, dict):
            raise ValueError(
                f"Tree '{label}' must be a mapping with `mat`/`metadata` keys, "
                f"got {type(entry).__name__}."
            )
        entry = dict(entry)
        unknown = set(entry) - allowed_keys
        if unknown:
            raise ValueError(
                f"Tree '{label}' has unexpected key(s) {sorted(unknown)}; "
                f"only {sorted(allowed_keys)} are per-tree settings (every "
                f"other setting is global)."
            )
        for required in REQUIRED_TREE_KEYS:
            if not entry.get(required):
                raise ValueError(
                    f"Tree '{label}' is missing required key '{required}'."
                )
        # Merge qc_filter_options: the global block, with each overridable key
        # replaced by this tree's value when present. The keys live *inside*
        # qc_filter_options (consumed by filter_metadata.py), so without this
        # merge every tree would silently share the global value. Each key is
        # optional: unset (or null) -> None, set explicitly so
        # filter_metadata.py always finds it (None means no cutoff).
        qc = dict(global_qc)
        for key in QC_OVERRIDABLE_KEYS:
            if key in entry:
                qc[key] = entry[key]
            qc.setdefault(key, None)
        entry["qc_filter_options"] = qc
        # Top-level per-tree overrides, validated here rather than at first use.
        # A cutoff becomes a directory name and a wildcard value, so a malformed
        # or out-of-range one would otherwise surface as a MissingInputException
        # naming a path nothing asked for (#149).
        for key in TREE_OVERRIDABLE_KEYS:
            if key not in entry:
                entry[key] = cfg.get(key)
        entry["pcp_date_cutoffs"] = cutoffs_mod.validate_cutoffs(
            entry.get("pcp_date_cutoffs") or [],
            qc["min_leaf_date"],
            qc.get("max_leaf_date"),
            label,
        )
        normalized[label] = entry
    return normalized


TREES = _normalize_trees(config)
TREE_LABELS = list(TREES)


def tree_cfg(label):
    """Return the normalized per-tree config for ``label``."""
    return TREES[label]


# =============================================================================
# Config Validation
# =============================================================================

# Required configuration parameters. ``mat``/``metadata`` are enforced per tree
# in ``_normalize_trees`` (above); ``output_dir`` no longer exists (it is derived
# from ``output_root`` + the ``{tree}`` label). The rest are global.
REQUIRED_CONFIG_PARAMS = [
    "clade_column",
    "ref_fasta",
    "ref_gtf",
    "max_nt_mutations",
    "max_reversions_to_ref",
    "max_reversions_to_clade_founder",
    "site_include_range",
    "qc_filter_options",
    "min_clade_size",
    "pcp_genes",
]

# Parameters required for full pipeline (may not be present in test mode)
OPTIONAL_CONFIG_PARAMS = [
    "site_mask_vcf",
    "usher_masked_sites",
    "clade_founders",
]

missing_params = [p for p in REQUIRED_CONFIG_PARAMS if p not in config]
if missing_params:
    raise ValueError(
        f"Missing required config parameters: {missing_params}\n"
        f"Please add these to your config.yaml file."
    )


# =============================================================================
# Wildcard Constraints
# =============================================================================

wildcard_constraints:
    clade="[A-Za-z0-9_.+-]+",  # Valid clade name characters
    tree=TREE_LABEL_PATTERN,   # Tree label (slash-free by construction)
    gene="[A-Za-z0-9_.+-]+",   # Gene symbol (a single path segment, slash-free)
    # Era names are enumerated, not a character class (#137). ``curated_counts``
    # / ``master_table`` / ``rates_table`` each exist as both a pooled literal
    # path and an ``_{era}`` wildcard path; an open-ended pattern would let the
    # wildcard rule also claim paths it has no business building.
    era="|".join(era_mod.ERAS),
    # A date cutoff (#149). Strict ISO, so the wildcard cannot swallow a path
    # segment: with ``clade`` and ``gene`` already slash-free, this keeps
    # ``pcps/{gene}/upto_{cutoff}/{clade}_pcps.csv.gz`` unambiguous against the
    # full-tree ``pcps/{gene}/{clade}_pcps.csv.gz``.
    cutoff=cutoffs_mod.CUTOFF_PATTERN,
    # A subsampling arm (#151), as an **optional path prefix including its
    # trailing slash**. Snakemake has no optional path components, so this is
    # what lets one rule serve both the full-tree path (``arm_dir=""``) and an
    # arm's (``arm_dir="cap_50000_0/"``) -- which is in turn what makes an arm
    # whose cap sits above every clade's size byte-identical to the full tree
    # *by construction* rather than by two rule bodies staying in sync.
    # ``clade`` and ``gene`` are already slash-free, so the empty alternative
    # cannot swallow an arm directory and the non-empty one cannot span two
    # segments.
    arm_dir=subsample_mod.ARM_DIR_PATTERN,
    # The same thing without the slash, for the one rule whose output *is* an
    # arm path (``subsample_clade_samples``) and so has no empty case.
    arm=subsample_mod.ARM_PATTERN,


# Disambiguate the aggregate rules from their per-clade counterparts. The
# aggregate outputs (``aggregated.csv``, ``all_pcps.csv.gz``, ``all_*_dasm_*``,
# ``all_aamut_fitness.csv``) live in the same directory as a ``{clade}`` output
# and their filenames are valid ``{clade}`` matches (``clade=aggregated`` /
# ``clade=all``). Before the multi-tree refactor these aggregate paths were
# fully concrete strings, so Snakemake auto-preferred them over the wildcarded
# per-clade rules; now that every path carries the ``{tree}`` wildcard, that
# implicit tie-break is gone and we must state the preference explicitly.
ruleorder: aggregate_mutation_counts > count_mutations_clade
ruleorder: aggregate_clade_pcps > extract_pcps_by_clade
ruleorder: curate_all_pcps_for_dasm > curate_pcps_for_dasm
ruleorder: aggregate_aamut_fitness > aamut_fitness_by_clade
# The same tie-break, one directory down, for the date-cutoff family (#149):
# ``upto_{cutoff}/all_pcps.csv.gz`` is a valid ``{clade}`` match for
# ``upto_{cutoff}/{clade}_pcps.csv.gz`` with ``clade=all``.
ruleorder: aggregate_clade_pcps_upto > extract_pcps_by_clade_upto
ruleorder: curate_all_pcps_for_dasm_upto > curate_pcps_for_dasm_upto


# =============================================================================
# Default Resources
# =============================================================================

# Default resource allocations (can be overridden per-rule)
default_resources = {
    "mem_mb": 4000,
    "runtime": 60,  # minutes
}


# =============================================================================
# Helper Functions
# =============================================================================

def get_threads(rule_name):
    """Get thread count for a rule from config with fallback to default."""
    if "threads" in config and rule_name in config["threads"]:
        return config["threads"][rule_name]
    elif "threads" in config and "default" in config["threads"]:
        return config["threads"]["default"]
    return 1


def get_final_tree():
    """Get the final tree path based on whether optimization is enabled.

    Returns a template carrying the ``{tree}`` placeholder (via ``OUTDIR``), so
    it resolves per tree when used as a rule input.
    """
    if config.get("optimize_tree", False):
        return os.path.join(OUTDIR, "mat/filtered_tree.pb")
    return os.path.join(OUTDIR, "mat/filtered_tree_raw.pb")


# =============================================================================
# Output Targets
# =============================================================================

# Proteins to generate PCPs and gene-sliced founder FASTAs for. A single
# Snakemake invocation fans PCP extraction over this list; coordinates come from
# ``pcp_gene_cds_blocks`` if it names the gene, otherwise from the reference GTF
# (see ``gtf.resolve_cds_blocks``). Output paths use the gene symbol verbatim
# (``pcps/S/``, ``clade_founders/S/``).
# Drop a sample from a *cutoff* set when its chronumental predicted date lands
# more than this many days after that cutoff. Optional; ``None`` disables the
# filter and reproduces the unfiltered cutoff selection exactly.
#
# A cutoff asks what had been collected by a date, and some metadata dates are
# wrong by years -- 16 leaves of the v12 public tree's 2023-01-01 set are JN.1 or
# KP.3.1.1 genomes reported 2020-2022 and predicted 337-570 days past the
# cutoff. The tolerance is non-zero because the predicted date is fitted, and it
# is a config value rather than a constant because it is a property of the date
# prior, which #146 has already moved once. See the comment block above
# ``cutoffs.select_for_cutoff`` for the measured distributions.
# Clade-subsampling arms (#151). ``max_samples`` thins every clade above the
# cap down to it and leaves smaller clades untouched, so an arm intervenes on
# the tree's **composition** -- which is what the pooled-vs-per-clade question
# actually asks about -- and one arm spans two orders of magnitude of effective
# depth, with the untouched clades as byte-identical controls by construction.
#
# Validated at parse time -- a cap below 1, a missing or non-integer
# ``max_samples`` and a duplicate arm name are all hard failures, never silent
# clamps, because a clamped depth produces a well-formed arm at the wrong depth.
# The removed fraction arms' ``sampling_fractions`` / ``unit`` keys are rejected
# by name, so a config written against them says what happened.
SUBSAMPLE_ARMS = subsample_mod.validate_entries(config.get("clade_subsamples"))

PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF = config.get("pcp_max_predicted_days_past_cutoff")
if PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF is not None:
    PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF = int(PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF)
    if PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF < 0:
        raise ValueError(
            f"config 'pcp_max_predicted_days_past_cutoff' must be >= 0 or null, "
            f"got {PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF}. Use null to disable the "
            f"filter; 0 demands that no predicted date exceed the cutoff at all, "
            f"which ordinary fit noise violates for samples collected just "
            f"before it (p95 |predicted - reported| is 35-37 days)."
        )

PCP_GENES = config["pcp_genes"]
if not PCP_GENES:
    raise ValueError(
        "config 'pcp_genes' must be a non-empty list of gene symbols "
        "(e.g. [S, ORF1ab, E]); got an empty list."
    )

# Explicit CDS blocks for PCP-only genes the shared reference GTF does not carry
# (ORF1b = nsp12-nsp16; #133). Deliberately NOT fed to ``edit_ref_gtf`` /
# ``ref_coding_sites``, so every fitness output is untouched. Validated in
# ``gtf.resolve_cds_blocks`` at the point of use, where the reference length is
# known; validated here only for keys, which is the check the scripts cannot do
# because each sees a single gene.
PCP_GENE_CDS_BLOCKS = config.get("pcp_gene_cds_blocks") or {}
_orphan_overrides = sorted(set(PCP_GENE_CDS_BLOCKS) - set(PCP_GENES))
if _orphan_overrides:
    raise ValueError(
        f"config 'pcp_gene_cds_blocks' names {_orphan_overrides}, which are not "
        f"in 'pcp_genes' ({list(PCP_GENES)}). An override for a gene that is "
        f"never extracted has no effect, so this is a typo rather than a "
        f"configuration -- most likely the gene was meant to be added to "
        f"'pcp_genes' too."
    )

# PCP gene -> the ``aamut_fitness`` gene it is validated against, plus the codon
# offset between them. Needed only where a PCP gene does not appear in
# ``aamut_fitness`` under its own name and numbering: ORF1a (dropped by
# ``aamutfit.get_coding``) and ORF1b (a PCP-only slice of ORF1ab). The offset is
# re-derived from the CDS blocks and cross-checked against this value at use
# (#133).
PCP_GENE_TO_FITNESS_GENE = config.get("pcp_gene_to_fitness_gene") or {}
_orphan_fitness_map = sorted(set(PCP_GENE_TO_FITNESS_GENE) - set(PCP_GENES))
if _orphan_fitness_map:
    raise ValueError(
        f"config 'pcp_gene_to_fitness_gene' names {_orphan_fitness_map}, which "
        f"are not in 'pcp_genes' ({list(PCP_GENES)})."
    )
for _gene, _spec in PCP_GENE_TO_FITNESS_GENE.items():
    if not isinstance(_spec, dict) or set(_spec) != {"gene", "codon_offset"}:
        raise ValueError(
            f"config 'pcp_gene_to_fitness_gene[{_gene}]' must be a mapping with "
            f"exactly the keys 'gene' and 'codon_offset'; got {_spec!r}"
        )


def cutoffs_for_tree(label):
    """This tree's validated ``pcp_date_cutoffs``, in config order (#149)."""
    return tree_cfg(label)["pcp_date_cutoffs"]


def cutoff_targets():
    """Every date-cutoff target across all trees, for ``rule all`` (#149).

    Built per tree rather than with a flat ``expand``, because ``cutoff`` is a
    per-tree setting: a flat product would request every tree's cutoffs from
    every tree, and a cutoff past a tree's ``max_leaf_date`` is rejected by
    ``validate_cutoffs`` for exactly that reason.
    """
    targets = []
    for label in TREE_LABELS:
        cutoffs = cutoffs_for_tree(label)
        if not cutoffs:
            continue
        outdir = tree_outdir(label)
        targets.append(os.path.join(outdir, "pcps/cutoff_summary.csv"))
        for cutoff in cutoffs:
            subdir = cutoffs_mod.cutoff_dir(cutoff)
            for gene in PCP_GENES:
                targets += [
                    os.path.join(outdir, "pcps", gene, subdir, name)
                    for name in (
                        "pcp_curation_report.txt",
                        "all_pcps_dasm_ready.csv.gz",
                        "dasm_ready_per_clade.done",
                    )
                ]
    return targets


def arm_targets():
    """Every subsampling-arm target across all trees, for ``rule all`` (#151).

    Empty for every config that sets no ``clade_subsamples``, which is all of
    them today except the test config: the production arms are launched by
    naming their paths, because a full-size arm costs ~8 CPU-hours.
    """
    if not SUBSAMPLE_ARMS:
        return []
    targets = []
    for label in TREE_LABELS:
        outdir = tree_outdir(label)
        targets.append(os.path.join(outdir, "correlation_summary.csv"))
        for arm in SUBSAMPLE_ARMS:
            targets += [
                os.path.join(outdir, "aamut_fitness", arm, "all_aamut_fitness.csv"),
                os.path.join(outdir, "fitness", arm, "ntmut_fitness_aggregated.csv"),
            ]
            for gene in PCP_GENES:
                targets += [
                    os.path.join(outdir, "pcps", gene, arm, name)
                    for name in (
                        "pcp_curation_report.txt",
                        "all_pcps_dasm_ready.csv.gz",
                        "dasm_ready_per_clade.done",
                    )
                ]
    return targets

# Terminal output files for the unified pipeline
# (intermediate files are created automatically as dependencies)
#
# Tree-only targets (fanned over ``tree`` in ``rule all``). Per-gene targets
# (PCP curation, founder slices, codon masks, DASM-ready PCPs) are fanned over
# ``tree x pcp_genes`` in ``rule all`` instead.
results_files = [
    "rates_table.csv",
    # Per-era neutral rate models (#137). This summary is the target that pulls
    # in glm/master_table_{era}.csv and rates_table_{era}.csv for every era
    # present on the tree, and records which eras were skipped -- an era absent
    # from a single-era tree is correct, but an unrecorded absence is
    # indistinguishable from an era that went missing.
    "glm/era_fit_summary.csv",
    "fitness/ntmut_fitness_aggregated.csv",
    "aamut_fitness/all_aamut_fitness.csv",
    # chronumental node dating (#116): the QC report transitively builds
    # mat/node_dates.tsv and gates the run on every tree.
    "mat/node_dates_qc.tsv",
    # The root-to-tip scatter (#146), which transitively builds
    # mat/node_dates_rtt.csv. Additive output with no consumer, so it ships
    # no-bump; wired in here because otherwise nothing would ever build it.
    "mat/node_dates_rtt_scatter.png",
    # Sliding-window per-mutation actual counts (#117); transitively builds
    # windows/founder_muts.csv. Additive output (no schema/consumer yet), so it
    # ships no-bump per the EPIC #115 coordinated-bump decision.
    "windows/subtree_counts.csv",
    # Windowed expected counts + delta_fitness_ratio (#118). Additive output,
    # also no-bump per the EPIC #115 coordinated-bump decision.
    "windows/fitness_trajectory.csv",
]

rule all:
    """Default target: produce all primary pipeline outputs for every tree."""
    input:
        expand(
            os.path.join(OUTDIR, "{f}"),
            tree=TREE_LABELS,
            f=results_files,
        ),
        # Per-gene PCP targets (tree x gene). The curation report pulls in each
        # gene's ``pcps/{gene}/all_pcps.csv.gz`` (and thus the per-clade PCPs and
        # gene-sliced founders).
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/pcp_curation_report.txt"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene founder-slice collectors (tree x gene): each pulls in that
        # gene's ``clade_founders/{gene}/{clade}.fa`` slices for every clade.
        expand(
            os.path.join(OUTDIR, "clade_founders/{gene}/founders.done"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene DASM training censor tables (tree x gene). Nothing inside this
        # repo consumes them -- the consumer is dasm2-experiments#1079 -- so
        # without this wiring they would never build (#144).
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/censored_mutations.csv"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene clade-independent nucleotide masks (tree x gene), the other
        # half of the same coordinate contract (#153). Since #158 the DASM-ready
        # filter reads this file, so it would be pulled in anyway; kept explicit
        # so a gene whose DASM-ready outputs are not requested still gets one.
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/masked_nt_sites.csv"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene DASM-ready PCPs (tree x gene): aggregate file + per-clade sentinel.
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/all_pcps_dasm_ready.csv.gz"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        expand(
            os.path.join(OUTDIR, "pcps/{gene}/dasm_ready_per_clade.done"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Per-gene PCP-vs-counts validation reports (tree x gene).
        expand(
            os.path.join(OUTDIR, "validation/{gene}/pcp_vs_counts_report.txt"),
            tree=TREE_LABELS,
            gene=PCP_GENES,
        ),
        # Date-cutoff PCP families (#149). Built per tree rather than as a flat
        # product because ``pcp_date_cutoffs`` is a per-tree setting; empty for
        # every config that does not set it.
        cutoff_targets(),
        # Clade-subsampling arms (#151). Empty unless the config sets
        # ``clade_subsamples``; production arms are launched by naming their
        # paths, since a full-size arm costs ~8 CPU-hours.
        arm_targets()


# =============================================================================
# Stage 1: Data Acquisition and Filtering
# =============================================================================

rule link_inputs:
    """Create symlinks to input MAT tree and metadata files."""
    params:
        mat=lambda wc: tree_cfg(wc.tree)["mat"],
        metadata=lambda wc: tree_cfg(wc.tree)["metadata"],
        output_dir=lambda wc: tree_outdir(wc.tree),
    output:
        mat=os.path.join(OUTDIR, "mat/mat_tree.pb.gz"),
        metadata=os.path.join(OUTDIR, "mat/metadata.tsv.gz")
    log:
        os.path.join(OUTDIR, "log/link_inputs.log")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            mkdir -p {params.output_dir}/mat
            ln -sf $(realpath {params.mat}) {output.mat}
            ln -sf $(realpath {params.metadata}) {output.metadata}
        ) > {log} 2>&1
        """


rule filter_metadata:
    """Filter the metadata to remove invalid sequences based on QC criteria."""
    input:
        metadata=rules.link_inputs.output.metadata
    output:
        filtered_metadata=os.path.join(OUTDIR, "mat/filtered_metadata.tsv.gz")
    params:
        qc_filter_options=lambda wc: tree_cfg(wc.tree)["qc_filter_options"],
        subset_frac=config.get("subset_frac", 1.0),
    threads: get_threads("filter_metadata")
    log:
        invalid_strains=os.path.join(OUTDIR, "log/invalid_strains.txt")
    conda:
        "envs/default.yml"
    script:
        "scripts/filter_metadata.py"


rule filter_mat_tree:
    """Extract valid sequences from the MAT tree based on filtered metadata."""
    input:
        mat_tree=rules.link_inputs.output.mat,
        filtered_metadata=rules.filter_metadata.output.filtered_metadata
    output:
        filtered_pb=os.path.join(OUTDIR, "mat/filtered_tree_raw.pb")
    threads: get_threads("filter_mat_tree")
    resources:
        # Measured: peaks at 31.5 GB on the v12 gisaid tree, so 16000 was
        # under-declared 2x.
        mem_mb=48000,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/filter_mat_tree.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/filter_mat_tree.stderr"),
        stdout=os.path.join(OUTDIR, "log/filter_mat_tree.stdout"),
        valid_strains=os.path.join(OUTDIR, "log/valid_strains.txt"),
    conda:
        "envs/usher.yml"
    params:
        mat_subset_kwargs=config.get("mat_subset_kwargs", "")
    shell:
        """
        # Extract strain names from filtered metadata
        zcat {input.filtered_metadata} | cut -f1 | sed 1,1d > {log.valid_strains}

        echo "Extracting $(wc -l < {log.valid_strains}) strains from MAT..." > {log.stdout}

        (
            # First extraction: filter to valid strains
            matUtils extract \
                -T {threads} \
                -i {input.mat_tree} \
                -s {log.valid_strains} \
                -o {output.filtered_pb}

            # Second extraction: apply any additional subset kwargs
            # This addresses a known issue where double extraction is needed
            if [ -n "{params.mat_subset_kwargs}" ]; then
                matUtils extract \
                    -T {threads} \
                    -i {output.filtered_pb} \
                    {params.mat_subset_kwargs} \
                    -o {output.filtered_pb}
            fi
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Filtered tree created: {output.filtered_pb}" >> {log.stdout}
        """


rule optimize_mat_tree:
    """Optimize the filtered tree for maximum parsimony (conditional)."""
    input:
        tree=rules.filter_mat_tree.output.filtered_pb
    output:
        optimized_tree=os.path.join(OUTDIR, "mat/filtered_tree.pb")
    threads: get_threads("optimize_mat_tree")
    resources:
        mem_mb=32000,
        runtime=480
    benchmark:
        os.path.join(OUTDIR, "benchmarks/optimize_mat_tree.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/optimize_mat_tree.stderr"),
        stdout=os.path.join(OUTDIR, "log/optimize_mat_tree.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Optimizing tree with {threads} threads..." > {log.stdout}
        (
            matOptimize \
                -i {input.tree} \
                -o {output.optimized_tree} \
                -T {threads}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Optimized tree created: {output.optimized_tree}" >> {log.stdout}
        """


rule export_newick:
    """Export the filtered MAT to Newick for chronumental (needs Newick, not .pb)."""
    input:
        tree=get_final_tree()
    output:
        nwk=os.path.join(OUTDIR, "mat/filtered_tree.nwk")
    log:
        stdout=os.path.join(OUTDIR, "log/export_newick.stdout"),
        stderr=os.path.join(OUTDIR, "log/export_newick.stderr")
    conda:
        "envs/usher.yml"
    shell:
        """
        matUtils extract -T {threads} -i {input.tree} -t {output.nwk} \
            > {log.stdout} 2> {log.stderr}
        """


rule chronumental:
    """Infer node dates (tips + internal) for the full filtered tree.

    Feeds the filtered metadata straight to chronumental, which auto-detects the
    strain/date columns (verified to give byte-identical dates to a hand-built
    strain->date table). Output ``node_dates.tsv`` has a header row then
    ``<node_id>\\t<predicted_date>`` for every node.
    """
    input:
        nwk=rules.export_newick.output.nwk,
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        node_dates=os.path.join(OUTDIR, "mat/node_dates.tsv"),
        # chronumental always writes the dated Newick tree; declare it (default
        # path is derived from --tree, so pass --tree_out explicitly) so it is
        # tracked/cleaned like any other output rather than left on disk.
        dated_tree=os.path.join(OUTDIR, "mat/chronumental_timetree.nwk")
    params:
        chronumental_kwargs=config.get("chronumental_kwargs", "")
    threads: get_threads("chronumental")
    resources:
        # Measured, not guessed: 46.6 GB max RSS over 282 minutes on
        # gisaid-and-public_2026-08-06 (20,992,217 branches) at --steps 1000, and
        # 22.4 GB / 110 min on public_2026-08-06. The previous 16000 / 240 was under
        # the real peak on BOTH axes, and this rule is the one that makes every
        # windowed output -- production runs use a local executor with no
        # --resources ceiling, so nothing enforced it and nothing failed. Same
        # correction, and the same reason, as chronumental_qc below (#139).
        #
        # These cover --steps 1000. The five configs that set no chronumental_kwargs
        # inherit chronumental's own --steps 20000 default, which extrapolates to
        # ~37 h on public and ~94 h on gisaid; pinning --steps across configs is
        # deliberately out of scope here (#146).
        mem_mb=64000,
        runtime=480
    benchmark:
        os.path.join(OUTDIR, "benchmarks/chronumental.tsv")
    log:
        stdout=os.path.join(OUTDIR, "log/chronumental.stdout"),
        stderr=os.path.join(OUTDIR, "log/chronumental.stderr")
    conda:
        "envs/chronumental.yml"
    shell:
        """
        chronumental --tree {input.nwk} {params.chronumental_kwargs} \
            --dates {input.metadata} --dates_out {output.node_dates} \
            --tree_out {output.dated_tree} \
            > {log.stdout} 2> {log.stderr}
        """


rule chronumental_qc:
    """Always-on per-tree sanity check of chronumental node dates.

    Wired into ``rule all`` so it runs on every tree (production + CI). Fails the
    run on any node-ID / monotonicity / coverage violation, and when the median
    absolute tip-date residual exceeds the configured threshold.
    """
    input:
        tree=get_final_tree(),
        node_dates=rules.chronumental.output.node_dates,
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        report=os.path.join(OUTDIR, "mat/node_dates_qc.tsv"),
        residuals=os.path.join(OUTDIR, "mat/node_dates_residuals.csv"),
        # Internal-node date distributions (#139). Binned, not per-branch: the
        # per-tip residuals file above is already 1.6 GB on the production tree,
        # and Delta-t in whole days is an integer so a histogram gives exact
        # medians and percentiles at a few tens of kB.
        branch_dt=os.path.join(OUTDIR, "mat/node_dates_branch_dt.csv"),
        # Per-bin median / IQR / p95 summary of the same distributions. Derived from
        # the same histograms as branch_dt above, so the two cannot disagree, and
        # every statistic is exact rather than interpolated.
        branch_dt_summary=os.path.join(
            OUTDIR, "mat/node_dates_branch_dt_summary.csv"
        ),
        internal_checks=os.path.join(OUTDIR, "mat/node_dates_internal_checks.csv"),
        # The exact joint histogram of (collection date, root-to-tip divergence)
        # over day-resolution tips (#146). Integer on both axes, so this IS the
        # joint distribution rather than a summary of it -- a few tens of kB
        # standing in for a 17 M-point cloud, and the input to the scatter that
        # ``chronumental_rtt_plot`` renders.
        rtt=os.path.join(OUTDIR, "mat/node_dates_rtt.csv"),
        # The root's fitted date, which is what anchors the fitted clock's own
        # predicted line on the scatter. A sidecar because it is the one
        # quantity that needs the TREE: finding the root means loading the
        # newick, which this rule already does and the plot rule deliberately
        # does not. It cannot be read off the log either -- chronumental's
        # ``root_date`` progress field is an internal parameterization, not the
        # root's date in days (#146).
        rtt_anchor=os.path.join(OUTDIR, "mat/node_dates_rtt_anchor.csv")
    params:
        max_median_abs_tip_residual_days=config.get(
            "chronumental_max_median_abs_tip_residual_days", 30
        ),
        # Check 5 compares the tree's own implied rate against chronumental's
        # pre-fit root-to-tip estimate, which it prints to stdout. A param rather
        # than an input on purpose: this is a ``log:`` entry, not a declared output,
        # so a missing file must not drag the multi-hour dating rule back into the
        # DAG. The script reports its absence explicitly instead (#146).
        chronumental_stdout=rules.chronumental.log.stdout
    threads: get_threads("chronumental_qc")
    resources:
        # Measured, not guessed: 43.4 GB max RSS over the 20,961,614 nodes of
        # gisaid-and-public_2026-04-22 (38.2 GB before the #139 checks added
        # their full-length per-node arrays). The previous 16000 was under the
        # real peak by more than 2x. Production runs use a local executor with
        # no --resources ceiling, so nothing enforced it and nothing failed --
        # which is exactly why it needs to be right before anyone runs this
        # under a scheduler that does enforce it.
        mem_mb=56000,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/chronumental_qc.tsv")
    log:
        os.path.join(OUTDIR, "log/chronumental_qc.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/chronumental_qc.py"


rule chronumental_rtt_plot:
    """Scatter the root-to-tip cloud behind chronumental's clock reference (#146).

    Split from ``chronumental_qc`` rather than folded into it because plotting needs
    matplotlib and that rule runs on ``envs/bte.yml``: widening a shared env changes
    its hash and hands every rule using it a ``software environment has changed``
    rerun trigger. This rule owns ``envs/plot.yml`` alone.

    Reads the exact joint histogram, not the tree, so it costs seconds and needs no
    bte -- and it recomputes its regression through the same
    ``node_date_qc.weighted_linregress`` the QC report used, so the figure and the
    report cannot disagree.
    """
    input:
        rtt=rules.chronumental_qc.output.rtt,
        rtt_anchor=rules.chronumental_qc.output.rtt_anchor
    output:
        plot=os.path.join(OUTDIR, "mat/node_dates_rtt_scatter.png")
    params:
        tree_label=lambda wildcards: wildcards.tree,
        # Same param-not-input treatment, and the same reason, as chronumental_qc:
        # a rotated-away log must not drag the dating rule back into the DAG. The
        # figure states the absence on its face instead (#146).
        chronumental_stdout=rules.chronumental.log.stdout
    threads: get_threads("chronumental_rtt_plot")
    resources:
        mem_mb=4000,
        runtime=20
    log:
        os.path.join(OUTDIR, "log/chronumental_rtt_plot.log")
    conda:
        "envs/plot.yml"
    script:
        "scripts/plot_rtt_scatter.py"


