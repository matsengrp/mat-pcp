rule curate_counts:
    """Curate counts for GLM training (filter to conserved sites, exclude problematic sites).

    Pools every clade, as in v9. ``rule curate_counts_era`` runs the same script
    restricted to one era; both are needed because the pooled fit is the control
    arm of the downstream per-era experiment (#137 Task 3), not legacy baggage.
    """
    input:
        # Pinned to the **full tree's** annotated counts, not
        # ``rules.annotate_counts.output`` -- that reference now carries
        # ``{arm_dir}`` and would drag the GLM refit into every arm. The
        # neutral model is fitted once, on all the data, and an arm reads it
        # unchanged; this is the deliberate cut in the dependency chain
        # ``annotate_counts -> curate_counts -> master_table -> rates_table``,
        # which otherwise makes refitting the default (#151).
        counts=os.path.join(OUTDIR, "glm/annotated_counts.csv"),
        clade_founder=os.path.join(OUTDIR, "glm/clade_founder_annotated.csv")
    output:
        curated=os.path.join(OUTDIR, "glm/curated_counts.csv")
    params:
        era=None
    log:
        os.path.join(OUTDIR, "log/curate_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_counts.py"


rule curate_counts_era:
    """Curate counts for one era's GLM training set (#137).

    The same script and the same site filters as ``rule curate_counts``, with the
    rows restricted to one era's clades. Deliberately *not* a filter applied to
    ``glm/curated_counts.csv``: that file's ``groupby`` has already pooled the
    clades away, so there is nothing left to partition on.
    """
    input:
        # Pinned to the **full tree's** annotated counts, not
        # ``rules.annotate_counts.output`` -- that reference now carries
        # ``{arm_dir}`` and would drag the GLM refit into every arm. The
        # neutral model is fitted once, on all the data, and an arm reads it
        # unchanged; this is the deliberate cut in the dependency chain
        # ``annotate_counts -> curate_counts -> master_table -> rates_table``,
        # which otherwise makes refitting the default (#151).
        counts=os.path.join(OUTDIR, "glm/annotated_counts.csv"),
        clade_founder=os.path.join(OUTDIR, "glm/clade_founder_annotated.csv")
    output:
        curated=os.path.join(OUTDIR, "glm/curated_counts_{era}.csv")
    params:
        era=lambda wildcards: wildcards.era
    log:
        os.path.join(OUTDIR, "log/curate_counts_{era}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_counts.py"


# =============================================================================
# Stage 6: GLM Rate Estimation & Master Table
# =============================================================================
#
# Three rate tables ship per tree (#137 Task 3, EPIC #138 decision 3):
# ``glm/master_table.csv`` (pooled, unchanged v9 meaning) plus
# ``glm/master_table_{era}.csv`` for each era present. Three files rather than
# one file with an ``era`` column, for two reasons specific to the consumers:
# ``Rates.residual_variance`` zips ``groupby(...).apply(...)`` output positionally
# against ``self.rates.loc[idx]`` (correct today only because the grid's
# construction order happens to equal sorted order), and DASM2's
# ``TabularRatesNeutralModel`` assigns ``wt_to_mut_rates[wt][mut]`` in a row loop,
# so an unrecognized extra column would be read **last-row-wins, silently**.

rule master_table:
    """Create master table with predicted mutation rates via GLM (pooled)."""
    input:
        curated_counts=rules.curate_counts.output.curated
    output:
        master_table=os.path.join(OUTDIR, "glm/master_table.csv")
    params:
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    threads: get_threads("master_table")
    resources:
        # Measured: peaks at 118 MB -- the GLM fit is small.
        mem_mb=2000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/master_table.tsv")
    log:
        os.path.join(OUTDIR, "log/master_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/master_table.py"


rule master_table_era:
    """Create one era's master rate table via GLM (#137).

    Runs the *same script* as ``rule master_table`` against that era's curated
    counts, so the two fits cannot differ in anything but their training rows --
    the property ISSUE-137 criterion 5 (single-era degeneracy is exact) rests on.
    """
    input:
        curated_counts=rules.curate_counts_era.output.curated
    output:
        master_table=os.path.join(OUTDIR, "glm/master_table_{era}.csv")
    params:
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    threads: get_threads("master_table")
    resources:
        # Measured: peaks at 118 MB -- the GLM fit is small.
        mem_mb=2000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/master_table_{era}.tsv")
    log:
        os.path.join(OUTDIR, "log/master_table_{era}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/master_table.py"


rule get_rates_table_era:
