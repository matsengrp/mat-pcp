# =============================================================================
# Stage 3d: Clade Founder Aggregation
# =============================================================================

rule clade_founder_nts:
    """Get nucleotide at each coding site for all clade founders."""
    input:
        coding_sites=rules.ref_coding_sites.output.csv,
        fastas=lambda wc: per_clade_inputs(CLADE_FOUNDER_FASTA, wc)
    output:
        csv=os.path.join(OUTDIR, "clade_founder_nts.csv")
    log:
        os.path.join(OUTDIR, "log/clade_founder_nts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_founder_nts.py"


# =============================================================================
# Stage 4: Unified Count Table
# =============================================================================

rule build_count_table:
    """Build the unified per-clade count table.

    Enumerates the full grid of all possible mutations (supplying the
    zero-actual-count rows the GLM trains on), joins the aggregated actual
    counts, and computes the ``exclude`` / ``masked_in_usher`` flags exactly
    once via ``modules/masking.compute_exclusions``. Replaces the former
    synonymous-rate expected-count and separate exclusion-aggregation rules.
    """
    input:
        actual=rules.aggregate_mutation_counts.output.csv,
        clade_founder_nts_csv=rules.clade_founder_nts.output.csv,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        site_mask=rules.get_site_mask.output.csv,
        usher_masked_sites=config["usher_masked_sites"]
    output:
        csv=os.path.join(OUTDIR, "counts_all.csv")
    params:
        sites_to_exclude=config.get("sites_to_exclude", []),
        site_include_range=config.get("site_include_range", {"start": 266, "end": 29674})
    log:
        os.path.join(OUTDIR, "log/build_count_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/build_count_table.py"


# =============================================================================
# Stage 5: Count Annotation and Curation for GLM
# =============================================================================

rule annotate_counts:
    """Annotate counts with RNA structure, sequence context, and other features."""
    input:
        counts=rules.build_count_table.output.csv,
        clade_founder=rules.clade_founder_nts.output.csv,
        rna_struct=config["rna_structure_data"]
    output:
        counts_csv=os.path.join(OUTDIR, "glm/annotated_counts.csv"),
        founder_csv=os.path.join(OUTDIR, "glm/clade_founder_annotated.csv")
    params:
        reference_clade=config.get("reference_clade", "19A"),
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    log:
        os.path.join(OUTDIR, "log/annotate_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/annotate_counts.py"


rule curate_counts:
    """Curate counts for GLM training (filter to conserved sites, exclude problematic sites)."""
    input:
        counts=rules.annotate_counts.output.counts_csv,
        clade_founder=rules.annotate_counts.output.founder_csv
    output:
        curated=os.path.join(OUTDIR, "glm/curated_counts.csv")
    log:
        os.path.join(OUTDIR, "log/curate_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_counts.py"


# =============================================================================
# Stage 6: GLM Rate Estimation & Master Table
# =============================================================================

rule master_table:
    """Create master table with predicted mutation rates via GLM."""
    input:
        curated_counts=rules.curate_counts.output.curated
    output:
        master_table=os.path.join(OUTDIR, "glm/master_table.csv")
    params:
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    threads: get_threads("master_table")
    resources:
        mem_mb=8000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/master_table.tsv")
    log:
        os.path.join(OUTDIR, "log/master_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/master_table.py"


rule get_rates_table:
    """Extract final rates table for sites after boundary."""
    input:
        master_table=rules.master_table.output.master_table
    output:
        rates_table=os.path.join(OUTDIR, "rates_table.csv")
    log:
        os.path.join(OUTDIR, "log/get_rates_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/get_rates_table.py"


rule window_expected_counts:
    """Windowed expected counts + delta_fitness_ratio (EPIC #115 Phase 3, #118).

    Turns the Phase-2 per-window founders + actual counts into a mutation x
    time-window fitness trajectory. For each window's subtree founder, enumerates
    all possible coding mutations from the founder sequence and looks up mat-pcp's
    GLM neutral rate for each mutation's founder-sequence context. Expected counts
    use mat-pcp's own clade-path ``evol_time`` normalization (``rates.py``) applied
    per window: ``T_window = (observed synonymous count) / (rate summed over all
    possible synonymous mutations)`` and ``expected(ID) = T_window x sum_founders
    rate(context)``, so total expected synonymous == total observed synonymous by
    construction. Then ``delta_fitness_ratio = log((actual + p) / (expected + p))``
    (matching ``aamutfit.ratio_fitness``).

    Expected counts come ONLY from the GLM (no synonymous-average fallback). ``T``
    divides out the rate's absolute scale, so the raw GLM rate is used directly.
    Pure pandas/numpy (no bte) -- runs in the default env. Placed here (after the
    GLM stage) because it depends on ``rules.master_table``.
    """
    input:
        founder_muts=rules.window_subtree_counts.output.founder_muts,
        subtree_counts=rules.window_subtree_counts.output.subtree_counts,
        master_table=rules.master_table.output.master_table,
        coding_sites=rules.ref_coding_sites.output.csv,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        site_mask=rules.get_site_mask.output.csv,
        rna_structure=config["rna_structure_data"],
    output:
        trajectory=os.path.join(OUTDIR, "windows/fitness_trajectory.csv"),
    params:
        # Global (clade-independent) masked sites reuse the clade path's config.
        sites_to_exclude=config.get("sites_to_exclude", []),
        site_include_range=config.get(
            "site_include_range", {"start": 266, "end": 29674}
        ),
        fitness_pseudocount=config.get("fitness_pseudocount", 0.5),
        # Drop founders whose subtree is <= this size (s2trajectory's
        # min_founder_children gate; default 0 keeps every subtree).
        min_subtree_size=config.get("window_min_subtree_size", 0),
    threads: get_threads("window_expected_counts")
    resources:
        mem_mb=16000,
        runtime=240
    benchmark:
        os.path.join(OUTDIR, "benchmarks/window_expected_counts.tsv")
    log:
        os.path.join(OUTDIR, "log/window_expected_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/window_expected_counts.py"


rule get_problematic_sites:
    """Identify problematic codon sites in one gene's CDS for masking.

    Fanned over ``pcp_genes``: emits ``<gene>_codon_sites_to_mask.txt`` per
    configured protein (the gene comes from the ``{gene}`` wildcard).

    Genes the reference GTF carries are matched against ``counts_all.csv``'s
    ``gene`` column. A gene added only through ``pcp_gene_cds_blocks`` (ORF1b)
    never appears there, so its codon sites are derived from its own CDS blocks
    instead -- hence the ``gtf`` input and the params. Matching on the name alone
    selected zero rows and wrote an empty mask at exit 0, leaving that gene's
    DASM-ready PCPs unmasked (#133).
    """
    input:
        expected_vs_actual=rules.build_count_table.output.csv,
        gtf=rules.edit_ref_gtf.output.gtf
    output:
        sites_to_mask=os.path.join(OUTDIR, "{gene}_codon_sites_to_mask.txt")
    params:
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    log:
        os.path.join(OUTDIR, "log/get_problematic_sites_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/get_problematic_sites.py"


