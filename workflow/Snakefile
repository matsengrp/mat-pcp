"""Top-level ``snakemake`` file that runs pipeline."""


import os
import textwrap
import yaml
import pandas as pd

configfile: "config/config.yaml"

# Function to get thread count with fallback to default
def get_threads(rule_name):
    """Get thread count for a rule from config with fallback to default"""
    if "threads" in config and rule_name in config["threads"]:
        return config["threads"][rule_name]
    elif "threads" in config and "default" in config["threads"]:
        return config["threads"]["default"]
    else:
        return 1  # Fallback if no thread config is available

# Function to determine the final tree output based on config
def get_final_tree(wildcards):
    """Get the final tree path based on whether optimization is enabled"""
    if config.get("optimize_tree", True):  # Default to True if not specified
        return f"results_{wildcards.mat}/mat/filtered_tree.pb"
    else:
        return f"results_{wildcards.mat}/mat/filtered_tree_raw.pb"

results_files = [
    "ref/coding_sites.csv",
    "mat/filtered_metadata.tsv.gz",
    "mat/all_pcps.csv"
]

rule all:
    """Target rule with desired output files."""
    input:
        expand(
            [os.path.join("results_{mat}", f) for f in results_files],
            mat=config["mat_trees"],
        )

rule get_mat_tree:
    """Get the pre-built mutation-annotated tree, nwk, and metadata"""
    params:
        mat=lambda wc: config["mat_trees"][wc.mat]["mat"],
        meta=lambda wc: config["mat_trees"][wc.mat]["meta"],
    threads: 1  # Linking files doesn't benefit from multiple threads
    output:
        mat="results_{mat}/mat/mat_tree.pb.gz",
        meta="results_{mat}/mat/tree_metadata.tsv.gz"
    shell:
        """
        ln -sr {params.mat} {output.mat}
        ln -sr {params.meta} {output.meta}
        """

rule filter_metadata:
    """filter the mat tree to remove invalid sequences"""
    input:
        meta="results_{mat}/mat/tree_metadata.tsv.gz"
    output:
        filtered_metadata="results_{mat}/mat/filtered_metadata.tsv.gz"
    params:
        qc_filter_options = config["qc_filter_options"],
        subset_frac = config["subset_frac"],
        datetime_cutoff = config["datetime_cutoff"]
    threads: get_threads("filter_metadata")
    log:
        notebook="results_{mat}/log/filter_metadata.ipynb",
        invalid_strains="results_{mat}/log/invalid_strains.txt"
    conda:
        "envs/default.yml"
    notebook:
        "notebooks/filter_metadata.ipynb"


rule filter_mat_tree:
    """
    extract valid sequences from the mat tree,
    and convert that subsetted tree to newick for chronumental.
    see https://github.com/matsengrp/s2trajectory/issues/9
    for why we double extract.
    """    
    input:
        mat_tree = rules.get_mat_tree.output.mat,
        filtered_metadata = rules.filter_metadata.output.filtered_metadata
    output:
        filtered_pb="results_{mat}/mat/filtered_tree_raw.pb"
    threads: get_threads("filter_mat_tree")
    log:
        stderr="results_{mat}/log/filter_mat_tree.stderr",
        stdout="results_{mat}/log/filter_mat_tree.stdout",
        valid_strains="results_{mat}/log/valid_strains.txt",
    conda:
        "envs/usher.yml"
    params:
        mat_subset_kwargs=config["mat_subset_kwargs"]
    shell:
        """
        zcat {input.filtered_metadata} | cut -f1 | sed 1,1d > {log.valid_strains}
        (
            matUtils extract \
                -i {input.mat_tree} \
                -s {log.valid_strains} \
                -o {output.filtered_pb}

            matUtils extract \
                -i {output.filtered_pb} \
                {params.mat_subset_kwargs} \
                -o {output.filtered_pb}
        ) > {log.stdout} 2> {log.stderr}
        """


rule optimize_mat_tree:
    """
    Optimize the filtered tree for maximum parsimony using matOptimize.
    This ensures the tree maintains optimal parsimony after extraction/filtering.
    This rule is conditional based on the optimize_tree config parameter.
    """
    input:
        tree = rules.filter_mat_tree.output.filtered_pb
    output:
        optimized_tree = "results_{mat}/mat/filtered_tree.pb"
    threads: get_threads("optimize_mat_tree")
    log:
        stderr = "results_{mat}/log/optimize_mat_tree.stderr",
        stdout = "results_{mat}/log/optimize_mat_tree.stdout"
    conda:
        "envs/usher.yml"
    shell:
        """
        (
            matOptimize \
                -i {input.tree} \
                -o {output.optimized_tree} \
                -T {threads}
        ) > {log.stdout} 2> {log.stderr}
        """


checkpoint get_clades:
    """Extract clade information from filtered metadata to determine which clades to process."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        clade_counts="results_{mat}/mat/clade_counts.csv"
    log:
        "results_{mat}/log/get_clades.log"
    threads: 1
    conda:
        "envs/default.yml"
    params:
        min_clade_size=config.get("min_clade_size", 100)
    shell:
        """
        (
            zcat {input.metadata} | \
            awk -F'\t' 'NR==1 {{for(i=1;i<=NF;i++) if($i=="Nextstrain_clade") col=i}} 
                        NR>1 && col {{print $col}}' | \
            sort | uniq -c | \
            awk -v min={params.min_clade_size} 'BEGIN {{print "nextstrain_clade,count,adequate_sample_counts"}} 
                 {{gsub(/^ +/, "", $0); split($0, a, " "); 
                   adequate=(a[1]>=min?"true":"false"); 
                   print a[2]","a[1]","adequate}}' > {output.clade_counts}
        ) > {log} 2>&1
        """


def clades_w_adequate_counts(wildcards):
    """Get list of clades with adequate sample counts."""
    checkpoint_output = checkpoints.get_clades.get(**wildcards).output.clade_counts
    clades_df = pd.read_csv(checkpoint_output)
    clades = clades_df[clades_df['adequate_sample_counts'] == 'true']['nextstrain_clade'].tolist()
    # Filter out excluded clades
    clades_to_exclude = config.get("clades_to_exclude", [])
    return [clade for clade in clades if clade not in clades_to_exclude]


rule samples_by_clade:
    """Extract sample names for a specific clade."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        samples="results_{mat}/mat/clades/{clade}_samples.txt"
    log:
        "results_{mat}/log/samples_by_clade_{clade}.log"
    threads: 1
    conda:
        "envs/default.yml"
    params:
        clade="{clade}"
    shell:
        """
        (
            zcat {input.metadata} | \
            awk -F'\t' -v clade="{params.clade}" \
            'NR==1 {{for(i=1;i<=NF;i++) {{if($i=="strain") strcol=i; if($i=="Nextstrain_clade") cladecol=i}}} 
             NR>1 && $cladecol==clade {{print $strcol}}' > {output.samples}
        ) > {log} 2>&1
        """


rule mat_clade_subset:
    """Extract mutation-annotated tree for a specific clade."""
    input:
        tree=lambda wildcards: get_final_tree(wildcards),
        samples=rules.samples_by_clade.output.samples
    output:
        tree="results_{mat}/mat/clades/{clade}_tree.pb"
    threads: get_threads("mat_clade_subset")
    log:
        stderr="results_{mat}/log/mat_clade_subset_{clade}.stderr",
        stdout="results_{mat}/log/mat_clade_subset_{clade}.stdout"
    conda:
        "envs/usher.yml"
    shell:
        """
        (
            matUtils extract \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) > {log.stdout} 2> {log.stderr}
        """


rule extract_pcps_by_clade:
    """Extract parent-child pairs (PCPs) from a clade-specific tree."""
    input:
        tree=rules.mat_clade_subset.output.tree,
        gtf="results_{mat}/ref/edited_ref.gtf",
        fasta="results_{mat}/ref/ref.fa"
    output:
        pcps="results_{mat}/mat/clades/{clade}_pcps.csv"
    threads: get_threads("extract_pcps")
    log:
        stderr="results_{mat}/log/extract_pcps_{clade}.stderr",
        stdout="results_{mat}/log/extract_pcps_{clade}.stdout"
    conda:
        "envs/bte.yml"
    shell:
        """
        (
            python workflow/scripts/pcp_from_tree.py \
                {input.tree} \
                {input.fasta} \
                {input.gtf} \
                {output.pcps}
        ) > {log.stdout} 2> {log.stderr}
        """


rule aggregate_clade_pcps:
    """Aggregate all clade-specific PCPs into a single file."""
    input:
        pcps=lambda wildcards: expand(
            "results_{mat}/mat/clades/{clade}_pcps.csv",
            mat=wildcards.mat,
            clade=clades_w_adequate_counts(wildcards)
        )
    output:
        all_pcps="results_{mat}/mat/all_pcps.csv"
    log:
        "results_{mat}/log/aggregate_clade_pcps.log"
    threads: 1
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_clade_pcps.py"


rule get_ref_fasta:
    """Get the reference FASTA."""
    params:
        url=config["ref_fasta"],
    threads: 1  # Network I/O doesn't benefit from multiple threads
    output:
        ref_fasta="results_{mat}/ref/ref.fa",
    shell:
        "curl -L {params.url} | gunzip -c > {output.ref_fasta}"


rule get_ref_gtf:
    """Get the reference GTF."""
    params:
        url=config["ref_gtf"],
    threads: 1  # Network I/O doesn't benefit from multiple threads
    output:
        ref_gtf="results_{mat}/ref/original_ref.gtf",
    shell:
        "curl -L {params.url} | gunzip -c > {output.ref_gtf}"


rule edit_ref_gtf:
    """Edit the reference GTF with manual additions."""
    input:
        gtf=rules.get_ref_gtf.output.ref_gtf
    output:
        gtf="results_{mat}/ref/edited_ref.gtf",
    threads: 1  # Simple file editing doesn't benefit from multiple threads
    params:
        edits=config["add_to_ref_gtf"],
    conda:
        "envs/default.yml"
    script:
        "scripts/edit_ref_gtf.py"


rule ref_coding_sites:
    """Get all sites in reference that are part of a coding sequence."""
    input:
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
    output:
        csv="results_{mat}/ref/coding_sites.csv",
    threads: get_threads("ref_coding_sites")
    conda:
        "envs/default.yml"
    script:
        "scripts/ref_coding_sites.py"


