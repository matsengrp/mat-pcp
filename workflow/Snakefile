# Stage 3c: Mutation Counting - Counting
# =============================================================================

rule count_mutations_clade:
    """Count mutations from matUtils translated mutations for a clade."""
    input:
        tsv=rules.translate_mat.output.tsv,
        nt_mut_csv=rules.sample_path_to_nt_mutations.output.csv,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        usher_masked_sites=config["usher_masked_sites"],
        site_mask=rules.get_site_mask.output.csv,
        clade_founder_fasta=rules.clade_founder_fasta.output.fasta,
        ref_to_founder_muts=rules.clade_founder_fasta.output.muts
    output:
        csv=os.path.join(config["output_dir"], "mutation_counts/{clade}.csv")
    params:
        max_nt_mutations=config.get("max_nt_mutations", 4),
        max_reversions_to_ref=config.get("max_reversions_to_ref", 1),
        max_reversions_to_clade_founder=config.get("max_reversions_to_clade_founder", 1),
        sites_to_exclude=config.get("sites_to_exclude", []),
        site_include_range=config.get("site_include_range", {"start": 266, "end": 29674}),
        exclude_ref_to_founder_muts=config.get("exclude_ref_to_founder_muts", True)
    log:
        os.path.join(config["output_dir"], "log/count_mutations_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/count_mutations.py"


rule aggregate_mutation_counts:
    """Aggregate mutation counts across all clades."""
    input:
        counts=lambda wc: expand(
            os.path.join(config["output_dir"], "mutation_counts/{clade}.csv"),
            clade=clades_w_adequate_counts(wc)
        )
    output:
        csv=os.path.join(config["output_dir"], "mutation_counts/aggregated.csv")
    log:
        os.path.join(config["output_dir"], "log/aggregate_mutation_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_mutation_counts.py"


# =============================================================================
# Stage 3d: Clade Founder Aggregation
# =============================================================================

rule clade_founder_nts:
    """Get nucleotide at each coding site for all clade founders."""
    input:
        coding_sites=rules.ref_coding_sites.output.csv,
        fastas=lambda wc: expand(
            os.path.join(config["output_dir"], "clade_founders/{clade}.fa"),
            clade=clades_w_adequate_counts(wc)
        )
    output:
        csv=os.path.join(config["output_dir"], "clade_founder_nts.csv")
    log:
        os.path.join(config["output_dir"], "log/clade_founder_nts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_founder_nts.py"


rule aggregate_mutations_to_exclude:
    """Compile comprehensive exclusion list from all sources."""
    input:
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        site_mask=rules.get_site_mask.output.csv,
        usher_masked_sites=config["usher_masked_sites"],
        clade_counts=rules.get_clades.output.clade_counts
    output:
        csv=os.path.join(config["output_dir"], "mutations_to_exclude.csv")
    params:
        site_include_range=config["site_include_range"],
        sites_to_exclude=config.get("sites_to_exclude", []),
        clade_column=config.get("clade_column", "Nextstrain_clade")
    log:
        os.path.join(config["output_dir"], "log/aggregate_mutations_to_exclude.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_mutations_to_exclude.py"


# =============================================================================
# Stage 4: Expected Mutation Counts
# =============================================================================

rule synonymous_mut_rates:
    """Compute synonymous mutation rates and spectra by clade."""
    input:
        mutation_counts_csv=rules.aggregate_mutation_counts.output.csv,
        clade_founder_nts_csv=rules.clade_founder_nts.output.csv
    output:
        rates_by_clade=os.path.join(config["output_dir"], "synonymous_mut_rates/rates_by_clade.csv")
    params:
        synonymous_spectra_min_counts=config.get("synonymous_spectra_min_counts", 5000)
    log:
        os.path.join(config["output_dir"], "log/synonymous_mut_rates.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/synonymous_mut_rates.py"


rule expected_mut_counts:
    """Compute expected mutation counts from synonymous rates."""
    input:
        rates_by_clade=rules.synonymous_mut_rates.output.rates_by_clade,
        clade_founder_nts_csv=rules.clade_founder_nts.output.csv
    output:
        expected_counts=os.path.join(config["output_dir"], "expected_mut_counts/expected_counts.csv")
    log:
        os.path.join(config["output_dir"], "log/expected_mut_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/expected_mut_counts.py"


rule merge_expected_and_actual_counts:
    """Merge expected and actual mutation counts with exclusion annotations."""
    input:
        expected=rules.expected_mut_counts.output.expected_counts,
        actual=rules.aggregate_mutation_counts.output.csv,
        muts_to_exclude=rules.aggregate_mutations_to_exclude.output.csv
    output:
        csv=os.path.join(config["output_dir"], "expected_vs_actual_mut_counts.csv")
    log:
        os.path.join(config["output_dir"], "log/merge_expected_and_actual_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/merge_expected_and_actual_counts.py"


# =============================================================================
# Stage 5: Count Annotation and Curation for GLM
# =============================================================================

rule annotate_counts:
    """Annotate counts with RNA structure, sequence context, and other features."""
    input:
        counts=rules.merge_expected_and_actual_counts.output.csv,
        clade_founder=rules.clade_founder_nts.output.csv,
        rna_struct=config["rna_structure_data"]
    output:
        counts_csv=os.path.join(config["output_dir"], "glm/annotated_counts.csv"),
        founder_csv=os.path.join(config["output_dir"], "glm/clade_founder_annotated.csv")
    params:
        reference_clade=config.get("reference_clade", "19A"),
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    log:
        os.path.join(config["output_dir"], "log/annotate_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/annotate_counts.py"


rule curate_counts:
    """Curate counts for GLM training (filter to conserved sites, exclude problematic sites)."""
    input:
        counts=rules.annotate_counts.output.counts_csv,
        clade_founder=rules.annotate_counts.output.founder_csv
    output:
        curated=os.path.join(config["output_dir"], "glm/curated_counts.csv")
    params:
        additional_sites_to_ignore=config.get("additional_sites_to_ignore", [])
    log:
        os.path.join(config["output_dir"], "log/curate_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_counts.py"


# =============================================================================
# Stage 6: GLM Rate Estimation & Master Table
# =============================================================================

rule master_table:
    """Create master table with predicted mutation rates via GLM."""
    input:
        curated_counts=rules.curate_counts.output.curated
    output:
        master_table=os.path.join(config["output_dir"], "glm/master_table.csv")
    params:
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    threads: get_threads("master_table")
    resources:
        mem_mb=8000,
        runtime=60
    benchmark:
        os.path.join(config["output_dir"], "benchmarks/master_table.tsv")
    log:
        os.path.join(config["output_dir"], "log/master_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/master_table.py"


rule get_rates_table:
    """Extract final rates table for sites after boundary."""
    input:
        master_table=rules.master_table.output.master_table
    output:
        rates_table=os.path.join(config["output_dir"], "rates_table.csv")
    log:
        os.path.join(config["output_dir"], "log/get_rates_table.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/get_rates_table.py"


rule get_problematic_sites:
    """Identify problematic codon sites in target gene for masking."""
    input:
        expected_vs_actual=rules.merge_expected_and_actual_counts.output.csv
    output:
        sites_to_mask=os.path.join(config["output_dir"], "spike_codon_sites_to_mask.txt")
