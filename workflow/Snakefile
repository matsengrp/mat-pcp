    params:
        orf1ab_to_nsps=config.get("orf1ab_to_nsps", {}),
        gene_overlaps=config.get("gene_overlaps", {"retain": [], "exclude": []}),
        genes=config.get("genes", []),
        fitness_pseudocount=config.get("fitness_pseudocount", 0.5)
    resources:
        mem_mb=2000,
        runtime=30
    benchmark:
