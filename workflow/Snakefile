# =============================================================================
# Stage 8: Validation - PCP vs Mutation Count Consistency
# =============================================================================

rule extract_mutations_from_pcps:
    """Extract AA mutation counts from one protein's PCPs by translating.

    Fanned over ``pcp_genes``: translates each protein's gene-sliced PCP
    sequences (``pcps/{gene}/all_pcps.csv.gz``) into per-codon AA mutations.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/all_pcps.csv.gz")
    output:
        aa_counts=os.path.join(OUTDIR, "validation/{gene}/pcp_aa_counts.csv")
    log:
        os.path.join(OUTDIR, "log/extract_mutations_from_pcps_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/extract_mutations_from_pcps.py"


rule validate_pcp_vs_counts:
    """Validate one protein's PCP-derived AA counts match aamut_fitness actual_count.

    Fanned over ``pcp_genes``. ``extract_mutations_from_pcps`` carries the
    ``{gene}`` wildcard; the aamut_fitness inputs hold every gene and are
    aligned to ``{gene}`` in the script -- via ``pcp_gene_to_fitness_gene``
    where the PCP gene is absent from ``aamut_fitness`` under its own name and
    numbering (ORF1a, ORF1b). The GTF is an input because that alignment
    re-derives the codon correspondence from both genes' CDS blocks rather than
    trusting the configured offset (#133).
    """
    input:
        pcp_counts=rules.extract_mutations_from_pcps.output.aa_counts,
        aamut_fitness_files=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "aamut_fitness/{clade}_aamut_fitness.csv"), wc
        ),
        all_aamut_fitness=rules.aggregate_aamut_fitness.output.csv,
        gtf=rules.edit_ref_gtf.output.gtf
    output:
        report=os.path.join(OUTDIR, "validation/{gene}/pcp_vs_counts_report.txt"),
        discrepancies=os.path.join(OUTDIR, "validation/{gene}/pcp_vs_counts_discrepancies.csv")
    params:
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS,
        pcp_gene_to_fitness_gene=PCP_GENE_TO_FITNESS_GENE
    log:
        os.path.join(OUTDIR, "log/validate_pcp_vs_counts_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/validate_pcp_vs_aamut.py"
