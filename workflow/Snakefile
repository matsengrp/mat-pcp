# =============================================================================
# Stage 3d: Clade Founder Aggregation
# =============================================================================

rule clade_founder_nts:
    """Get nucleotide at each coding site for all clade founders."""
    input:
        coding_sites=rules.ref_coding_sites.output.csv,
        # ``CLADE_FOUNDER_FASTA`` carries no ``{arm_dir}`` on purpose: a
        # founder is a property of the clade's defining mutations, not of which
        # samples were collected, so ``clade_founder_fasta`` reads only the
        # Neher/Roemer JSONs and the reference. An arm therefore reads the very
        # same FASTAs and differs only in *which clades* the table spans --
        # which it must, or a unit clade thinned below ``min_clade_size`` would
        # reappear in the arm's grid as an all-zero row rather than being
        # absent (#151).
        fastas=lambda wc: per_clade_inputs(CLADE_FOUNDER_FASTA, wc)
    output:
        csv=os.path.join(OUTDIR, "{arm_dir}clade_founder_nts.csv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}clade_founder_nts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_founder_nts.py"


