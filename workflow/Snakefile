rule window_subtree_counts:
    """Bucket branch mutations into sliding time windows over the full tree.

    EPIC #115 Phase 2 (#117). Over the full dated tree, groups observed branch
    mutations into overlapping time windows (anchored at the end date, tiled
    backwards) and emits per-window subtree founders + per-mutation actual
    counts. Branch QC reuses the clade path's config keys / semantics. No
    expected counts / delta_fitness_ratio (Phase 3).
    """
    input:
        tree=get_final_tree(),
        node_dates=rules.chronumental.output.node_dates,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        coding_sites=rules.ref_coding_sites.output.csv,
    output:
        founder_muts=os.path.join(OUTDIR, "windows/founder_muts.csv"),
        subtree_counts=os.path.join(OUTDIR, "windows/subtree_counts.csv"),
    params:
        window_size=config.get("window_size", 90),
        window_step=config.get("window_step", 45),
        window_start_time=config.get("window_start_time", None),
        window_end_time=config.get("window_end_time", None),
        # Reuse the SAME branch-QC keys as the clade-based count_mutations path
        # so the two analysis paths filter branches identically.
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"],
        max_reversions_to_clade_founder=config["max_reversions_to_clade_founder"],
    threads: get_threads("window_subtree_counts")
    resources:
        # Measured: peaks at 67.3 GB on the v12 gisaid tree, so 16000 was
        # under-declared 4.2x.
        mem_mb=80000,
        runtime=240
    benchmark:
        os.path.join(OUTDIR, "benchmarks/window_subtree_counts.tsv")
    log:
        os.path.join(OUTDIR, "log/window_subtree_counts.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/window_subtree_counts.py"


rule validate_windowing:
    """Tree-level correctness harness for the windowing algorithm (#117).

    A CI-only target (built explicitly on the test config, NOT in
    ``results_files``): grid anchoring, partition/overlap, and the step-vs-size
    masking asymmetry, using synthetic times injected over the real test nodes.

    Script is ``validate_windowing_tree.py`` (the bte-env tree-level checks) --
    distinct from the standalone ``validate_windowing.py``, which CI runs
    directly for the pure-function + output-CSV checks (base env). Threads reuse
    the ``window_subtree_counts`` key since both are the same one-off bte pass.
    """
    input:
        tree=get_final_tree(),
        node_dates=rules.chronumental.output.node_dates,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        coding_sites=rules.ref_coding_sites.output.csv,
    output:
        report=os.path.join(OUTDIR, "windows/validation_report.txt"),
    params:
        window_size=config.get("window_size", 90),
        window_step=config.get("window_step", 45),
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"],
        max_reversions_to_clade_founder=config["max_reversions_to_clade_founder"],
    threads: get_threads("window_subtree_counts")
    resources:
        # Reads the same windowed data as window_subtree_counts, whose
        # measured peak is 67.3 GB.
        mem_mb=80000,
        runtime=240
    log:
        os.path.join(OUTDIR, "log/validate_windowing.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/validate_windowing_tree.py"


