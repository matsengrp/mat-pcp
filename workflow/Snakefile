# =============================================================================
# Stage 2: Clade Processing and PCP Extraction
# =============================================================================

checkpoint get_clades:
    """Identify clades with adequate sample counts for processing."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        clade_counts=os.path.join(OUTDIR, "mat/clade_counts.csv")
    log:
        os.path.join(OUTDIR, "log/get_clades.log")
    params:
        min_clade_size=config.get("min_clade_size", 100),
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting clade counts from metadata..."
            zcat {input.metadata} | \
            awk -F'\\t' 'NR==1 {{for(i=1;i<=NF;i++) if($i=="{params.clade_column}") col=i}}
                        NR>1 && col {{print $col}}' | \
            sort | uniq -c | \
            awk -v min={params.min_clade_size} 'BEGIN {{print "{params.clade_column},count,adequate_sample_counts"}}
                 {{gsub(/^ +/, "", $0); split($0, a, " ");
                   adequate=(a[1]>=min?"true":"false");
                   print a[2]","a[1]","adequate}}' > {output.clade_counts}

            echo "Clade counts summary:"
            cat {output.clade_counts}
            echo ""
            echo "Clades with adequate counts (>= {params.min_clade_size}):"
            grep ",true" {output.clade_counts} | wc -l
        ) > {log} 2>&1
        """


def clades_w_adequate_counts(wildcards):
    """
    Get list of clades with adequate sample counts for a given tree.

    This function is used with Snakemake checkpoints to dynamically determine
    which clades have enough samples for analysis. It resolves the checkpoint
    per tree via ``wildcards.tree``; ``clade_column``/``clades_to_exclude``/
    ``max_clades`` are read from the global config (they are not per-tree).
    """
    checkpoint_output = checkpoints.get_clades.get(tree=wildcards.tree).output.clade_counts
    clades_df = pd.read_csv(checkpoint_output)
    clade_col = config.get("clade_column", "Nextstrain_clade")
    clades = clades_df[clades_df['adequate_sample_counts'] == True][clade_col].tolist()
    clades_to_exclude = config.get("clades_to_exclude", [])
    clades = [clade for clade in clades if clade not in clades_to_exclude and pd.notna(clade)]
    # Limit number of clades for faster testing (set max_clades in config)
    max_clades = config.get("max_clades", None)
    if max_clades is not None and max_clades > 0:
        clades = clades[:max_clades]
    return clades


def eras_present(wildcards):
    """The eras that have at least one clade on this tree, in ``ERAS`` order.

    The neutral-rate split (#137) fits one model per era. An era with no clades
    cannot be fitted -- ``populate_rates`` raises ``No trained weights found for
    mutation type AC ... Available mutation types: []`` on an empty partition --
    and this is not hypothetical: ``config_test_data.yaml``'s ``max_clades: 3``
    yields 19A/19B/20A, all pre-Omicron, and the BA.2/JN.1/XFG trees are
    single-era by construction too.

    Because a Snakemake rule must produce every output it declares, the skip
    happens **here, at DAG-construction time**, by simply not requesting the
    absent era's table -- rather than by having the fit rule emit a placeholder
    (a header-only file or a ``touch()``), which would ship a rate table that
    looks like a fit and contains nothing. Which eras were skipped is recorded in
    ``glm/era_fit_summary.csv`` so the absence is auditable from the output tree
    (``rule era_fit_summary``).

    Raises via ``era.era_for_clade`` on a clade with no era, which is the
    intended behaviour: an unmapped clade must stop the run rather than land in a
    default bucket. Configs whose clade column carries non-clade values
    (``recombinant`` in the test data) exclude them via ``clades_to_exclude``.
    """
    clades = clades_w_adequate_counts(wildcards)
    partition = era_mod.partition_clades(clades)
    return [era for era in era_mod.ERAS if era in partition]


def era_rate_table_inputs(wildcards):
    """Per-era master and rates tables for the eras present on this tree."""
    outdir = tree_outdir(wildcards.tree)
    return [
        os.path.join(outdir, subpath.format(era=era))
        for era in eras_present(wildcards)
        for subpath in ("glm/master_table_{era}.csv", "rates_table_{era}.csv")
    ]


def curated_counts_by_era_inputs(wildcards):
    """``{f"curated_{era}": path}`` for each era present on this tree.

    Returned as a dict for ``unpack()`` so the consumer addresses each training
    frame **by era name** rather than by position in a list. A positional pairing
    of two lists (paths, era names) is the #133 ``gene``/``codon_site`` trap: the
    two zip cleanly whichever way round they are, and swapping the era labels
    would fit each era's model and serve it to the other era's clades -- a
    plausible rate table, no error.
    """
    outdir = tree_outdir(wildcards.tree)
    return {
        f"curated_{era}": os.path.join(outdir, f"glm/curated_counts_{era}.csv")
        for era in eras_present(wildcards)
    }


def per_clade_inputs(path_template, wildcards, extra_clades=()):
    """Expand ``path_template`` over this (tree, arm)'s adequate-count clades.

    ``path_template`` carries the ``{tree}`` and ``{clade}`` wildcards (e.g.
    ``os.path.join(OUTDIR, "pcps/{clade}_pcps.csv.gz")`` or
    ``CLADE_FOUNDER_FASTA``) and, for a rule on the subsampling-arm path (#151),
    ``{arm_dir}`` as well. Used in ``input:`` lambdas of the aggregate rules so
    every per-clade fan-out resolves the checkpoint the same way.
    ``extra_clades`` appends non-checkpoint clades such as ``"all"``.

    This is the **grid-derived** fan-out: on an arm, every clade in the roster
    takes the arm's prefix, including ``extra_clades``. It is right for anything
    sliced out of the arm's own re-aggregated count table
    (``fitness/{arm}/expected_counts_by_clade.csv`` and everything below it), so
    the arm's pooled ``all`` row is the arm's rather than the full tree's -- even
    where a non-unit clade's numbers necessarily come out identical.

    Anything derived from a clade's **subtree** instead uses
    ``per_unit_clade_inputs``: a non-unit clade was never thinned, so it has no
    arm subtree and requesting one would send it through the sampler.
    """
    kwargs = {}
    if "{arm_dir}" in path_template:
        kwargs["arm_dir"] = arm_dir_of(wildcards)
    return expand(
        path_template,
        tree=wildcards.tree,
        clade=arm_clades(wildcards) + list(extra_clades),
        **kwargs,
    )


def clades_w_adequate_counts_upto(wildcards):
    """This (tree, cutoff)'s clades, in the *full roster's* order.

    Order is not cosmetic. ``aggregate_clade_pcps`` concatenates its inputs in
    order, so the aggregate's row order follows this list -- and the degenerate
    arm (a cutoff equal to ``max_leaf_date``) is required to reproduce the
    full-tree aggregate byte-for-byte. Filtering ``clades_w_adequate_counts``
    rather than re-sorting the checkpoint's rows makes that identity hold by
    construction instead of resting on the two orderings happening to agree,
    which they do today only because both sources are sorted and ``max_clades``
    truncates a sorted list.

    Filtering the full roster also re-applies ``clades_to_exclude`` and
    ``max_clades`` here, so a cutoff can never process a clade the full tree
    does not.
    """
    counts_csv = checkpoints.get_clades_by_cutoff.get(tree=wildcards.tree).output.counts
    counts = pd.read_csv(counts_csv)
    arm = counts[counts["cutoff"].astype(str) == str(wildcards.cutoff)]
    if arm.empty:
        raise ValueError(
            f"Cutoff {wildcards.cutoff!r} does not appear in {counts_csv}. The "
            f"checkpoint was built against a different `pcp_date_cutoffs`; it "
            f"needs rebuilding."
        )
    adequate = set(arm.loc[arm["adequate_sample_counts"] == True, "clade"])
    return [c for c in clades_w_adequate_counts(wildcards) if c in adequate]


def per_clade_inputs_upto(path_template, wildcards):
    """Expand ``path_template`` over one (tree, cutoff)'s included clades."""
    return expand(
        path_template,
        tree=wildcards.tree,
        cutoff=wildcards.cutoff,
        clade=clades_w_adequate_counts_upto(wildcards),
    )


def _requested_clades_by_cutoff(wildcards):
    """``{cutoff: [clade, ...]}`` for every cutoff this tree carries.

    Passed to ``cutoff_pcp_summary`` as a param so the recorded ``included``
    column comes from the function that actually drove the fan-out, not from a
    second read of the checkpoint's own verdict. A summary that merely copied
    that verdict could not detect a fan-out which declined a clade the
    checkpoint approved -- the failure the file exists to expose (#137).
    """
    # A plain namedtuple rather than ``type(wildcards)(...)``: Snakemake's
    # Wildcards is built per rule with a fixed field set, so reconstructing it
    # with a different one raises.
    fake = collections.namedtuple("CutoffWildcards", ["tree", "cutoff"])
    return {
        cutoff: clades_w_adequate_counts_upto(fake(wildcards.tree, cutoff))
        for cutoff in cutoffs_for_tree(wildcards.tree)
    }


# =============================================================================
# Clade-subsampling arms (#151)
# =============================================================================
# An **arm** is one per-clade cap. Everything an arm rebuilds follows from
# re-extracting each thinned clade's subtree from a subsampled sample list,
# because ``mat/clades/{clade}_samples.txt`` is the only
# thing determining a clade's subtree: ``translate_mat``, ``mat_sample_paths``
# and ``extract_pcps_by_clade`` all read ``mat_clade_subset`` and nothing below
# it re-reads the full tree. Subsampling that one list therefore moves the
# counts arm and the PCP arm together, by construction rather than by two
# parallel wirings.
#
# **The rule for what an arm rebuilds is one line: rebuild anything that counts
# mutations, reuse anything that was fitted or defined once.** Rebuilt, in
# pipeline order: ``mat/clades/{arm}/`` -> ``mutations/{arm}/`` ->
# ``mutation_counts/{arm}/`` -> ``{arm}/counts_all.csv`` ->
# ``glm/{arm}/annotated_counts.csv`` -> ``fitness/{arm}/`` ->
# ``aamut_fitness/{arm}/`` -> ``pcps/{gene}/{arm}/``. Reused in place: the GLM
# neutral fit (``glm/curated_counts*.csv``, ``glm/master_table*.csv``,
# ``rates_table*.csv``), the clade founders, ``ref/``, ``mat/node_dates*``,
# ``windows/``, and each gene's codon mask and censor table.
#
# ``glm/`` straddles that line and the cut has to be deliberate:
# ``glm/{arm}/annotated_counts.csv`` is count-bearing and is rebuilt, while
# ``glm/curated_counts.csv`` is the GLM's *training set* and is not. The
# dependency chain ``count_mutations_clade -> ... -> annotate_counts ->
# curate_counts -> master_table -> rates_table.csv`` makes refitting the
# default, so ``curate_counts`` deliberately carries no ``{arm_dir}``: an arm's
# ``expected_counts_by_clade`` reads the **full tree's** per-era curated tables
# and only its ``counts`` input from the arm. This hands the counts arm
# full-tree neutral information it would not have if the clade were genuinely
# this thinly sampled, which is conservative for the hypothesis being tested --
# it can only make the counts estimator look better.
#
# The per-clade ``evol_time`` normalization *does* track the subsample, which is
# the intended effect: it is what makes an arm's expected counts fall with the
# cap.


def arm_dir_of(wildcards):
    """This rule invocation's arm directory, ``""`` on the full-tree path."""
    return getattr(wildcards, "arm_dir", "") or ""


def arm_spec(arm):
    """The validated ``{"seed", "cap"}`` for one arm name."""
    try:
        return SUBSAMPLE_ARMS[arm]
    except KeyError:
        raise ValueError(
            f"Arm {arm!r} appears in a requested path but not in config "
            f"'clade_subsamples'. Configured arms: {sorted(SUBSAMPLE_ARMS)}"
        )


def arm_spec_from_wildcards(wildcards):
    """The arm spec for a rule carrying ``{arm}`` (never the full-tree path)."""
    return arm_spec(wildcards.arm)


def clade_sizes(wildcards):
    """``{clade: n_samples}`` from the ``get_clades`` checkpoint."""
    counts_csv = checkpoints.get_clades.get(tree=wildcards.tree).output.clade_counts
    counts = pd.read_csv(counts_csv)
    clade_col = config.get("clade_column", "Nextstrain_clade")
    return dict(zip(counts[clade_col], counts["count"]))


def arm_clade_sizes(wildcards):
    """``{clade: n_samples}`` restricted to this tree's *processed* roster.

    ``clade_counts.csv`` names every clade the metadata mentions, including ones
    dropped by ``clades_to_exclude`` or beyond ``max_clades``, which have no
    subtree to thin. An arm's unit is derived from clade sizes, so deriving it
    from the raw counts would request ``mat/clades/{arm}/21A_samples.txt`` for a
    clade the pipeline never extracts -- and 21A is exactly that case on every
    production tree (no clade founder is defined for it, so it is excluded).

    Kept in the roster's order, because ``resolve_unit`` preserves the order it
    is given and the aggregate rules concatenate their inputs in it: an
    untouched clade's byte-equality with the full tree rests on that.
    """
    sizes = clade_sizes(wildcards)
    return {c: sizes[c] for c in clades_w_adequate_counts(wildcards) if c in sizes}


def arm_units_for_tree(wildcards):
    """``{arm: [clades it thins]}`` for this tree.

    The single place an arm's membership is resolved -- it is derived from the
    clade sizes rather than named, so it cannot be written in the config. Every
    fan-out helper, the roster param and the sampler's defensive check read this,
    so they cannot disagree about one clade.
    """
    return subsample_mod.arm_units(SUBSAMPLE_ARMS, arm_clade_sizes(wildcards))


def arm_unit_of(wildcards, arm):
    """This arm's unit as a ``set``, for membership tests in the fan-outs."""
    return set(arm_units_for_tree(wildcards)[arm])


def arm_retained_counts(wildcards):
    """``{arm: {clade: n_retained}}`` for this tree, from the clade counts.

    Arithmetic over an existing checkpoint rather than a new one: the retained
    count is exactly ``min(n_clade, cap)``, so nothing has to be drawn to know
    it. A clade thinned below ``min_clade_size`` is dropped from the arm and
    recorded, because ``get_clades`` applies that threshold to the full metadata
    and so cannot see a clade that falls below it only after thinning -- which
    happens exactly when ``min_clade_size > cap``.
    """
    return subsample_mod.check_arm_sizes(
        SUBSAMPLE_ARMS,
        arm_clade_sizes(wildcards),
        min_clade_size=config.get("min_clade_size", 100),
    )


def arm_clades(wildcards):
    """This (tree, arm)'s clade roster, in the *full roster's* order.

    Order is not cosmetic, for the same reason as #149's cutoff roster: the
    aggregate rules concatenate their inputs in order, and an arm whose cap sits
    above every clade's size is required to reproduce the full-tree aggregates
    byte-for-byte. Filtering ``clades_w_adequate_counts`` rather than re-deriving
    a list makes that hold by construction.

    An arm keeps every clade the full tree processes **except** unit clades
    thinned below ``min_clade_size``: a non-unit clade is untouched by the
    subsample and its rows must stay in the grid, or the arm's ``counts_all.csv``
    would no longer be comparable to the full tree's.
    """
    full = clades_w_adequate_counts(wildcards)
    arm_dir = arm_dir_of(wildcards)
    if not arm_dir:
        return full
    arm = arm_dir.rstrip("/")
    unit = arm_unit_of(wildcards, arm)
    kept = arm_retained_counts(wildcards)[arm]
    return [c for c in full if c not in unit or c in kept]


def per_unit_clade_inputs(path_template, wildcards):
    """The **subtree-derived** fan-out: arm paths for unit clades, full otherwise.

    An arm thins only the clades named in its unit. A non-unit clade therefore
    has no arm subtree at all, and its per-clade counts and PCPs are read
    **straight from the full tree's files** rather than recomputed or copied
    into the arm directory. Three things follow, and they are the reason this is
    a separate helper rather than a conditional inside ``per_clade_inputs``:

    - the non-unit rows of an arm's aggregates are bit-identical by
      construction rather than by recomputation, which is the correctness
      guarantee;
    - an arm re-*aggregates* every clade (``build_count_table`` needs the whole
      grid) while re-*counting* only the unit, which is most of the cost saving;
    - requesting an arm path for a non-unit clade would route it through
      ``subsample_clade_samples`` and thin a clade the config never named.
    """
    arm_dir = arm_dir_of(wildcards)
    unit = arm_unit_of(wildcards, arm_dir.rstrip("/")) if arm_dir else set()
    return [
        path_template.format(
            tree=wildcards.tree,
            arm_dir=arm_dir if clade in unit else "",
            clade=clade,
        )
        for clade in arm_clades(wildcards)
    ]


def _arm_roster_param(wildcards):
    """``{arm: {"unit", "seed", "cap", "included"}}`` for the correlations.

    Passed as a param so ``thinned`` comes from the function that actually drove
    the fan-out rather than from a second evaluation of the sizing arithmetic:
    membership is derived from the tree's clade sizes, and a consumer that
    re-derived it would be a second definition free to disagree about a clade.
    """
    retained = arm_retained_counts(wildcards)
    units = arm_units_for_tree(wildcards)
    roster = {}
    for arm, spec in SUBSAMPLE_ARMS.items():
        kept = retained[arm]
        unit = units[arm]
        roster[arm] = {
            # The *resolved* unit. There is no configured one to fall back on --
            # membership is derived from the clade sizes -- so recording what the
            # fan-out actually used is the whole point of passing this as a param.
            "unit": list(unit),
            "seed": spec["seed"],
            "cap": spec["cap"],
            "included": [c for c in unit if c in kept],
        }
    return roster


rule samples_by_clade:
    """Extract sample names for a specific clade."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        samples=os.path.join(OUTDIR, "mat/clades/{clade}_samples.txt")
    log:
        os.path.join(OUTDIR, "log/samples_by_clade_{clade}.log")
    params:
        clade="{clade}",
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting samples for clade: {params.clade}"
            zcat {input.metadata} | \
            awk -F'\\t' -v clade="{params.clade}" \
            'NR==1 {{for(i=1;i<=NF;i++) {{if($i=="strain") strcol=i; if($i=="{params.clade_column}") cladecol=i}}}}
             NR>1 && $cladecol ~ "^"clade"( |$)" {{print $strcol}}' > {output.samples}

            echo "Found $(wc -l < {output.samples}) samples for clade {params.clade}"
        ) > {log} 2>&1
        """


rule mat_clade_subset:
    """Extract mutation-annotated tree for a specific clade."""
    input:
        tree=get_final_tree(),
        # Not ``rules.samples_by_clade.output.samples``: with ``{arm_dir}``
        # empty this *is* that path, and with it set the list comes from
        # ``subsample_clade_samples`` instead. Naming the template rather than
        # one producer is what lets a single rule serve both (#151).
        samples=os.path.join(OUTDIR, "mat/clades/{arm_dir}{clade}_samples.txt")
    output:
        tree=os.path.join(OUTDIR, "mat/clades/{arm_dir}{clade}_tree.pb")
    threads: get_threads("mat_clade_subset")
    resources:
        # Measured: 104 benchmarks on the v12 gisaid tree peak at 25.0 GB,
        # median 23.3 GB, against a previous declaration of 8000. Like every
        # other `mem_mb` here this is inert -- production uses the local
        # executor with no `--resources` ceiling -- so it is a record of what
        # the rule costs rather than a limit, kept accurate for the same reason
        # as #146's chronumental correction: a number 3x under the real peak
        # reads as measured when it is not, and would over-subscribe whoever
        # first runs this under a scheduler that honours the request.
        #
        # The cost is a property of the *input tree*, not of how many samples
        # the clade keeps: `matUtils extract -s` loads the whole MAT before
        # pruning, and 21I at 8% of 21J's sample count measured slightly more.
        # So it does not fall as the cap falls.
        mem_mb=28000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/{arm_dir}mat_clade_subset_{clade}.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/{arm_dir}mat_clade_subset_{clade}.stderr"),
        stdout=os.path.join(OUTDIR, "log/{arm_dir}mat_clade_subset_{clade}.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting clade subtree for {wildcards.clade}..." > {log.stdout}
        echo "Input tree: {input.tree}" >> {log.stdout}
        echo "Samples file: {input.samples}" >> {log.stdout}
        echo "Sample count: $(wc -l < {input.samples})" >> {log.stdout}

        (
            matUtils extract \
                -T {threads} \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Clade subtree created: {output.tree}" >> {log.stdout}
        """


rule extract_pcps_by_clade:
    """Extract and curate parent-child pairs from a clade-specific tree.

    Drops branches whose parent/child are identical within the gene-region
    slice in the same pass that constructs them. Emits both the curated PCP
    table and a per-clade list of identical-slice branch IDs (consumed by
    `count_mutations_clade` to harmonize mutation counting).
    """
    input:
        tree=rules.mat_clade_subset.output.tree,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        clade_founder_fasta=CLADE_FOUNDER_FASTA,
        coding_sites=rules.ref_coding_sites.output.csv
    output:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}{clade}_pcps.csv.gz"),
        filtered_branches=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}{clade}_filtered_branches.csv"
        )
    params:
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"],
        max_reversions_to_clade_founder=config["max_reversions_to_clade_founder"],
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    threads: get_threads("extract_pcps")
    resources:
        # Measured on the v12 gisaid tree over the 422 full-tree benchmarks of
        # this rule and `extract_pcps_by_clade_upto` pooled (197 + 225; both
        # share this declaration, so both are counted): 482 MB median to
        # 77.3 GB for ORF1a/21J, a 160x spread, because peak cost tracks the
        # clade's subtree and the gene's CDS length together -- ORF1a peaks at
        # 230-277x its input .pb, S near 108x. A flat 8000 under-granted 59 of
        # those 422 and 12 exceeded 32 GB, while a flat value covering the tail
        # (80000) would cap a 995 GB box at 12 concurrent jobs whose median
        # need is under 500 MB. Scaling on input size instead leaves the small
        # jobs small; `attempt` is the safety net for a tree outside the
        # measured envelope.
        #
        # **The floor, not the multiplier, is what most jobs get, so it is
        # sized against the #151 arms rather than the full tree.** 307 of the
        # 449 checkable full-tree jobs are floor-bound, and *all 684* arm jobs
        # are: thinning shrinks a clade's `.pb` without shrinking its PCP
        # expansion proportionally, so an arm's peak/input runs to 737x against
        # ORF1a's 230-277x at full depth -- `cap_50000_0` ORF1a/21J peaks at
        # 5304 MB from an 8.4 MB subtree. A floor of 4000 therefore under-
        # granted 2 of 684 arm jobs while under-granting none of the full-tree
        # ones, which is exactly the population a root-only census cannot see.
        # 6000 gives zero under-grants across all 1133 checkable jobs. The 225
        # `_upto` pairs stay unverifiable because `mat/cutoffs/*.pb` is
        # `temp()`; the peak among them (77347 MB) is within 17 MB of its
        # verified full-tree twin.
        #
        # Like every other `mem_mb` here this is inert under the local executor
        # -- it records what the rule costs rather than limiting it.
        mem_mb=lambda wildcards, input, attempt: max(
            6000, int(300 * input.size_mb)
        ) * attempt,
        runtime=120
    benchmark:
        os.path.join(OUTDIR, "benchmarks/{arm_dir}extract_pcps_{gene}_{clade}.tsv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}extract_pcps_{gene}_{clade}.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/pcp_from_tree.py"


rule aggregate_clade_pcps:
    """Aggregate a gene's clade-specific PCPs into a single file."""
    input:
        pcps=lambda wc: per_unit_clade_inputs(
            os.path.join(OUTDIR, "pcps", wc.gene, "{arm_dir}{clade}_pcps.csv.gz"), wc
        )
    output:
        all_pcps=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}all_pcps.csv.gz")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}aggregate_clade_pcps_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_clade_pcps.py"


rule aggregate_filtered_branches:
    """Aggregate per-clade filtered branch IDs and create curation report."""
    input:
        curated_pcps=rules.aggregate_clade_pcps.output.all_pcps,
        filtered_branches=lambda wc: per_unit_clade_inputs(
            os.path.join(
                OUTDIR, "pcps", wc.gene, "{arm_dir}{clade}_filtered_branches.csv"
            ),
            wc,
        )
    output:
        report=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}pcp_curation_report.txt"),
        filtered_branches=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}filtered_branch_ids.csv"
        )
    log:
        os.path.join(OUTDIR, "log/{arm_dir}aggregate_filtered_branches_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_filtered_branches.py"


# =============================================================================
# DASM-ready PCP curation
# =============================================================================
# These rules emit ``*_pcps_dasm_ready.csv.gz`` siblings of the existing
# ``*_pcps.csv.gz`` files. The filter set + train/val split mirrors
# ``dasm2 preprocess`` exactly (reimplemented in plain NumPy here so the
# rule can stay in ``envs/default.yml`` without pulling in torch/dasm2).
#
# Seed convention (mirrors ``data-central/scripts/filter_viral_pcps.sh``):
#   per-clade  -> seed=1729
#   aggregate  -> seed=42
# The aggregate's seed differs intentionally; it's a guardrail against
# accidentally producing the aggregate with the per-clade default.
#
# Once v2 ships, these outputs replace the post-hoc
# ``data-central/scripts/filter_viral_pcps.sh`` step.

rule curate_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to one clade's gene PCPs.

    Fanned over ``pcp_genes`` x clades: each protein's PCPs are filtered
    against that protein's own nucleotide mask
    (``pcps/{gene}/masked_nt_sites.csv``). Through v12 that was the same mask
    widened to codons; #158 retired the codon file so this filter and DASM's
    loss read one mask at one granularity.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}{clade}_pcps.csv.gz"),
        # The mask is deliberately **not** arm-prefixed. It is invariant to
        # sampling depth by construction: ``masked_nt_sites.py`` derives it
        # from the config, the ProblematicSites VCF and ``site_include_range``
        # -- never from a count column -- and reconciles it against
        # ``exclude``, which ``masking.compute_exclusions`` likewise derives
        # from config, the VCF, ``usher_masked_sites.yaml`` and the founder
        # grid. So reusing it is a no-op rather than a leak, unlike #149's
        # temporal carve-out.
        mask_sites=os.path.join(OUTDIR, "pcps/{gene}/masked_nt_sites.csv")
    output:
        dasm_ready=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}{clade}_pcps_dasm_ready.csv.gz"
        ),
        report=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}{clade}_dasm_filter_report.txt"
        ),
        stats=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}{clade}_dasm_filter_stats.json"
        )
    params:
        seed=1729,
        val_fraction=0.10
    benchmark:
        os.path.join(
            OUTDIR, "benchmarks/{arm_dir}curate_pcps_for_dasm_{gene}_{clade}.tsv"
        )
    log:
        os.path.join(OUTDIR, "log/{arm_dir}curate_pcps_for_dasm_{gene}_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


rule curate_all_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to the all-clades aggregate.

    Uses a different seed (42) than the per-clade rule (1729) by repository
    convention; this matches ``filter_viral_pcps.sh``'s guardrail.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}all_pcps.csv.gz"),
        mask_sites=os.path.join(OUTDIR, "pcps/{gene}/masked_nt_sites.csv")
    output:
        dasm_ready=os.path.join(
            OUTDIR, "pcps/{gene}/{arm_dir}all_pcps_dasm_ready.csv.gz"
        ),
        report=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}all_dasm_filter_report.txt"),
        stats=os.path.join(OUTDIR, "pcps/{gene}/{arm_dir}all_dasm_filter_stats.json")
    params:
        seed=42,
        val_fraction=0.10
    benchmark:
        os.path.join(
            OUTDIR, "benchmarks/{arm_dir}curate_all_pcps_for_dasm_{gene}.tsv"
        )
    log:
        os.path.join(OUTDIR, "log/{arm_dir}curate_all_pcps_for_dasm_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


