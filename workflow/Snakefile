rule window_expected_counts:
    """Windowed expected counts + delta_fitness_ratio (EPIC #115 Phase 3, #118).

    Turns the Phase-2 per-window founders + actual counts into a mutation x
    time-window fitness trajectory. For each window's subtree founder, enumerates
    all possible coding mutations from the founder sequence and looks up mat-pcp's
    GLM neutral rate for each mutation's founder-sequence context. Expected counts
    use mat-pcp's own clade-path ``evol_time`` normalization (``rates.py``) applied
    per window: ``T_window = (observed synonymous count) / (rate summed over all
    possible synonymous mutations)`` and ``expected(ID) = T_window x sum_founders
    rate(context)``, so total expected synonymous == total observed synonymous by
    construction. Then ``delta_fitness_ratio = log((actual + p) / (expected + p))``
    (matching ``aamutfit.ratio_fitness``).

    Expected counts come ONLY from the GLM (no synonymous-average fallback). ``T``
    divides out the rate's absolute scale, so the raw GLM rate is used directly.
    Pure pandas/numpy (no bte) -- runs in the default env. Placed here (after the
    GLM stage) because it depends on ``rules.master_table``.
    """
    input:
        founder_muts=rules.window_subtree_counts.output.founder_muts,
        subtree_counts=rules.window_subtree_counts.output.subtree_counts,
        master_table=rules.master_table.output.master_table,
        coding_sites=rules.ref_coding_sites.output.csv,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        site_mask=rules.get_site_mask.output.csv,
        rna_structure=config["rna_structure_data"],
    output:
        trajectory=os.path.join(OUTDIR, "windows/fitness_trajectory.csv"),
    params:
        # Global (clade-independent) masked sites reuse the clade path's config.
        sites_to_exclude=config.get("sites_to_exclude", []),
        site_include_range=config.get(
            "site_include_range", {"start": 266, "end": 29674}
        ),
        fitness_pseudocount=config.get("fitness_pseudocount", 0.5),
        # Drop founders whose subtree is <= this size (s2trajectory's
        # min_founder_children gate; default 0 keeps every subtree).
        min_subtree_size=config.get("window_min_subtree_size", 0),
    threads: get_threads("window_expected_counts")
    resources:
        # Measured: peaks at 7.8 GB.
        mem_mb=12000,
        runtime=240
    benchmark:
        os.path.join(OUTDIR, "benchmarks/window_expected_counts.tsv")
    log:
        os.path.join(OUTDIR, "log/window_expected_counts.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/window_expected_counts.py"


def _gene_founder_slice_map(wildcards):
    """``{clade: founder-slice path}`` for one gene, over this tree's clades.

    One definition feeding two rule fields: ``input`` takes the values (so the
    slices are built), ``params`` takes the mapping (so the script keys by clade
    name). Passing only the input list would make the script pair paths against
    ``params.clades`` *positionally*, which is the class of bug CLAUDE.md
    pattern 11 documents -- a reordering would check every mask against the wrong
    clade's founder and still produce a well-formed table.
    """
    return {
        clade: GENE_FOUNDER_FASTA.format(
            tree=wildcards.tree, gene=wildcards.gene, clade=clade
        )
        for clade in clades_w_adequate_counts(wildcards)
    }


rule masked_nt_sites:
    """Emit one gene's clade-independent nucleotide mask for DASM training.

    The companion to ``censor_table``: that rule carries the two clade-specific
    reasons of ``masking.compute_exclusions``' five, this one the three
    clade-independent ones (ProblematicSites VCF, config ``sites_to_exclude``,
    outside ``site_include_range``) at **nucleotide** granularity. Together they
    give a consumer the complete nucleotide mask with no codon widening
    anywhere (#153).

    Shipped in #153 as a separate rule rather than a second output on the
    then-existing ``get_problematic_sites``, whose codon file had seven
    consumers: re-running that rule to add an output would have restated every
    PCP for a file nothing yet read. It carried the codon file as an *input* so
    the two granularities could be cross-checked (guard 2). #158 retired the
    codon file and pointed ``curate_pcps_for_dasm`` here instead, so that input
    and that guard are gone -- this is now the only producer of the
    clade-independent mask, at the granularity the loss uses.

    Cheap: a pure function of the config, the VCF, the edited GTF, the reference
    and one pass over ``counts_all.csv``'s two reconciliation columns.
    """
    input:
        # Full tree, not the arm's, for the same reason ``curate_pcps_for_dasm``
        # reads the full tree's mask: the global mask is invariant to sampling
        # depth by construction (it never reads a count column, only
        # `exclude`).
        counts=os.path.join(OUTDIR, "counts_all.csv"),
        site_mask=rules.get_site_mask.output.csv,
        gtf=rules.edit_ref_gtf.output.gtf,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta
    output:
        table=os.path.join(OUTDIR, "pcps/{gene}/masked_nt_sites.csv")
    params:
        sites_to_exclude=config.get("sites_to_exclude", []),
        site_include_range=config.get(
            "site_include_range", {"start": 266, "end": 29674}
        ),
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    resources:
        # Measured on the v12 gisaid tree, whose counts_all.csv is the largest
        # this pipeline has produced (564 MB, 5.0 M rows): 237 MB peak RSS for
        # the first gene and 449 MB cumulative across all six run in one
        # process, so no single job exceeds ~320 MB. The cost is the two-column
        # parse and is flat in the gene. Declared with headroom rather than at
        # the measurement, per pattern 16's rule that the number record what the
        # rule costs.
        mem_mb=1000
    benchmark:
        os.path.join(OUTDIR, "benchmarks/masked_nt_sites_{gene}.tsv")
    log:
        os.path.join(OUTDIR, "log/masked_nt_sites_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/masked_nt_sites.py"


rule censor_table:
    """Emit one gene's per-clade, per-nucleotide censor table for DASM training.

    UShER masking deletes mutations from the MAT rather than marking sites
    ambiguous, so a masked site is *censored, not ambiguous*: the state is known,
    the event was destroyed. Training therefore needs the coordinates in the
    loss, not an ``N`` in the sequence. The retired
    ``{gene}_codon_sites_to_mask.txt`` could not serve: it never reached the
    loss, it was codon-granular, and it was clade-independent by construction
    (#144).

    Carries the two clade-specific reasons of ``masking.compute_exclusions``'
    five; the other three are in ``masked_nt_sites.csv``, so a training run
    applies **both** files. Additive output -- no existing schema is read and no
    consumer inside this repo reads it, so the CLAUDE.md carve-out applied and
    it shipped no-bump inside v11.

    Cheap: a pure function of the UShER yaml, the edited GTF, the reference, and
    the ``get_clades`` checkpoint. The founder slices are inputs only for the
    orientation guard.
    """
    input:
        usher_masked_sites=config["usher_masked_sites"],
        gtf=rules.edit_ref_gtf.output.gtf,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta,
        founders=lambda wc: list(_gene_founder_slice_map(wc).values())
    output:
        table=os.path.join(OUTDIR, "pcps/{gene}/censored_mutations.csv"),
        clades=os.path.join(OUTDIR, "pcps/{gene}/censored_mutations.clades.txt")
    params:
        clades=clades_w_adequate_counts,
        founder_fastas=_gene_founder_slice_map,
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    log:
        os.path.join(OUTDIR, "log/censor_table_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/censor_table.py"


# =============================================================================
# Stage 7: Nucleotide Fitness Estimation
# =============================================================================

rule expected_counts_by_clade:
    """Add GLM-expected counts to mutation counts for each clade.

    Since #137 each clade is served by its **own era's** neutral model, so the
    training inputs are the per-era curated tables rather than the pooled one.
    ``unpack`` names them ``curated_{era}``: the script addresses each training
    frame by era name, never by position (a swapped pair would fit both models
    correctly and serve each to the other era's clades, with no error anywhere).

    On a single-era tree exactly one file arrives and this reduces to the v9
    pooled fit, which is why the test-data run still reproduces the v9 fitness
    md5s and so acts as a regression check on the split.
    """
    input:
        unpack(curated_counts_by_era_inputs),
        counts=rules.annotate_counts.output.counts_csv,
    output:
        csv=os.path.join(OUTDIR, "fitness/{arm_dir}expected_counts_by_clade.csv")
    params:
        lightswitch_boundaries=config.get("glm_lightswitch_boundaries", {
            "CT": 13467, "AT": 21562, "CG": 21562, "GC": 21562
        })
    log:
        os.path.join(OUTDIR, "log/{arm_dir}expected_counts_by_clade.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/expected_counts_by_clade.py"


rule ntmut_counts_by_clade:
    """Extract nucleotide mutation counts for a specific clade."""
    input:
        counts=rules.expected_counts_by_clade.output.csv
    output:
        csv=os.path.join(
            OUTDIR, "fitness/ntmut_counts/{arm_dir}{clade}_ntmut_counts.csv"
        )
    params:
        clade="{clade}"
    log:
        os.path.join(OUTDIR, "log/{arm_dir}ntmut_counts_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ntmut_counts_by_clade.py"


rule ntmut_fitness_by_clade:
    """Compute probabilistic fitness estimates for nucleotide mutations per clade."""
    input:
        counts=rules.ntmut_counts_by_clade.output.csv
    output:
        csv=os.path.join(
            OUTDIR, "fitness/ntmut_fitness/{arm_dir}{clade}_ntmut_fitness.csv"
        )
    params:
        N_f=config.get("fitness_N_f", 300),
        N_n_exp=config.get("fitness_N_n_exp", 300)
    threads: get_threads("ntmut_fitness")
    resources:
        # Measured: peaks at 311 MB over 404 benchmarks (238 MB for the
        # nucleotide rule, 311 MB for the amino-acid one).
        mem_mb=1000,
        runtime=30
    benchmark:
        os.path.join(OUTDIR, "benchmarks/{arm_dir}ntmut_fitness_{clade}.tsv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}ntmut_fitness_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ntmut_fitness.py"


rule aggregate_ntmut_fitness:
    """Aggregate nucleotide fitness across all clades."""
    input:
        fitness_files=lambda wc: per_clade_inputs(
            os.path.join(
                OUTDIR, "fitness/ntmut_fitness/{arm_dir}{clade}_ntmut_fitness.csv"
            ),
            wc, extra_clades=["all"]
        )
    output:
        csv=os.path.join(OUTDIR, "fitness/{arm_dir}ntmut_fitness_aggregated.csv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}aggregate_ntmut_fitness.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_ntmut_fitness.py"


# =============================================================================
# Stage 7b: Amino Acid Fitness Estimation
# =============================================================================

rule aamut_fitness_by_clade:
    """Compute amino acid mutation fitness estimates per clade."""
    input:
        ntmut_fitness=rules.ntmut_fitness_by_clade.output.csv
    output:
        csv=os.path.join(OUTDIR, "aamut_fitness/{arm_dir}{clade}_aamut_fitness.csv")
    params:
        orf1ab_to_nsps=config.get("orf1ab_to_nsps", {}),
        gene_overlaps=config.get("gene_overlaps", {"retain": [], "exclude": []}),
        genes=config.get("genes", []),
        fitness_pseudocount=config.get("fitness_pseudocount", 0.5)
    resources:
        # Measured: peaks at 311 MB over 404 benchmarks (238 MB for the
        # nucleotide rule, 311 MB for the amino-acid one).
        mem_mb=1000,
        runtime=30
    benchmark:
        os.path.join(OUTDIR, "benchmarks/{arm_dir}aamut_fitness_{clade}.tsv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}aamut_fitness_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aamut_fitness.py"


rule aggregate_aamut_fitness:
    """Aggregate amino acid fitness across all clades."""
    input:
        fitness_files=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "aamut_fitness/{arm_dir}{clade}_aamut_fitness.csv"), wc
        )
    output:
        csv=os.path.join(OUTDIR, "aamut_fitness/{arm_dir}all_aamut_fitness.csv")
    log:
        os.path.join(OUTDIR, "log/{arm_dir}aggregate_aamut_fitness.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_aamut_fitness.py"


# =============================================================================
# Stage 8: Validation - PCP vs Mutation Count Consistency
# =============================================================================

rule extract_mutations_from_pcps:
    """Extract AA mutation counts from one protein's PCPs by translating.

    Fanned over ``pcp_genes``: translates each protein's gene-sliced PCP
    sequences (``pcps/{gene}/all_pcps.csv.gz``) into per-codon AA mutations.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/all_pcps.csv.gz")
    output:
        aa_counts=os.path.join(OUTDIR, "validation/{gene}/pcp_aa_counts.csv")
    log:
        os.path.join(OUTDIR, "log/extract_mutations_from_pcps_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/extract_mutations_from_pcps.py"


rule validate_pcp_vs_counts:
    """Validate one protein's PCP-derived AA counts match aamut_fitness actual_count.

    Fanned over ``pcp_genes``. ``extract_mutations_from_pcps`` carries the
    ``{gene}`` wildcard; the aamut_fitness inputs hold every gene and are
    aligned to ``{gene}`` in the script -- via ``pcp_gene_to_fitness_gene``
    where the PCP gene is absent from ``aamut_fitness`` under its own name and
    numbering (ORF1a, ORF1b). The GTF is an input because that alignment
    re-derives the codon correspondence from both genes' CDS blocks rather than
    trusting the configured offset (#133).
    """
    input:
        pcp_counts=rules.extract_mutations_from_pcps.output.aa_counts,
        aamut_fitness_files=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "aamut_fitness/{clade}_aamut_fitness.csv"), wc
        ),
        # Full tree, not ``rules.aggregate_aamut_fitness.output`` -- that
        # reference now carries ``{arm_dir}``. Validation compares the
        # full-depth PCPs against the full-depth fitness table; an arm has its
        # own copies of both and is not cross-validated here (#151).
        all_aamut_fitness=os.path.join(OUTDIR, "aamut_fitness/all_aamut_fitness.csv"),
        gtf=rules.edit_ref_gtf.output.gtf
    output:
        report=os.path.join(OUTDIR, "validation/{gene}/pcp_vs_counts_report.txt"),
        discrepancies=os.path.join(OUTDIR, "validation/{gene}/pcp_vs_counts_discrepancies.csv")
    params:
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS,
        pcp_gene_to_fitness_gene=PCP_GENE_TO_FITNESS_GENE
    log:
        os.path.join(OUTDIR, "log/validate_pcp_vs_counts_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/validate_pcp_vs_aamut.py"
