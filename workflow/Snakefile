rule ntmut_fitness_by_clade:
    """Compute probabilistic fitness estimates for nucleotide mutations per clade."""
    input:
        counts=rules.ntmut_counts_by_clade.output.csv
    output:
        csv=os.path.join(config["output_dir"], "fitness/ntmut_fitness/{clade}_ntmut_fitness.csv")
    params:
        N_f=config.get("fitness_N_f", 300),
        N_n_exp=config.get("fitness_N_n_exp", 300)
    threads: get_threads("ntmut_fitness")
    resources:
        mem_mb=2000,
        runtime=30
    benchmark:
        os.path.join(config["output_dir"], "benchmarks/ntmut_fitness_{clade}.tsv")
    log:
        os.path.join(config["output_dir"], "log/ntmut_fitness_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ntmut_fitness.py"


rule aggregate_ntmut_fitness:
    """Aggregate nucleotide fitness across all clades."""
    input:
        fitness_files=lambda wc: expand(
            os.path.join(config["output_dir"], "fitness/ntmut_fitness/{clade}_ntmut_fitness.csv"),
            clade=clades_w_adequate_counts(wc) + ["all"]
        )
