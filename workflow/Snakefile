    threads: get_threads("ref_coding_sites")
    log:
        os.path.join(config["output_dir"], "log/ref_coding_sites.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/ref_coding_sites.py"


# =============================================================================
# Stage 2: Clade Processing and PCP Extraction
# =============================================================================

checkpoint get_clades:
    """Identify clades with adequate sample counts for processing."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        clade_counts=os.path.join(config["output_dir"], "mat/clade_counts.csv")
    log:
        os.path.join(config["output_dir"], "log/get_clades.log")
    params:
        min_clade_size=config.get("min_clade_size", 100),
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting clade counts from metadata..."
            zcat {input.metadata} | \
            awk -F'\\t' 'NR==1 {{for(i=1;i<=NF;i++) if($i=="{params.clade_column}") col=i}}
                        NR>1 && col {{print $col}}' | \
            sort | uniq -c | \
            awk -v min={params.min_clade_size} 'BEGIN {{print "{params.clade_column},count,adequate_sample_counts"}}
                 {{gsub(/^ +/, "", $0); split($0, a, " ");
                   adequate=(a[1]>=min?"true":"false");
                   print a[2]","a[1]","adequate}}' > {output.clade_counts}

            echo "Clade counts summary:"
            cat {output.clade_counts}
            echo ""
            echo "Clades with adequate counts (>= {params.min_clade_size}):"
            grep ",true" {output.clade_counts} | wc -l
        ) > {log} 2>&1
        """


def clades_w_adequate_counts(wildcards=None):
    """
    Get list of clades with adequate sample counts.

    This function is used with Snakemake checkpoints to dynamically determine
    which clades have enough samples for analysis.
    """
    checkpoint_output = checkpoints.get_clades.get().output.clade_counts
    clades_df = pd.read_csv(checkpoint_output)
    clade_col = config.get("clade_column", "Nextstrain_clade")
    clades = clades_df[clades_df['adequate_sample_counts'] == True][clade_col].tolist()
    clades_to_exclude = config.get("clades_to_exclude", [])
    clades = [clade for clade in clades if clade not in clades_to_exclude and pd.notna(clade)]
    # Limit number of clades for faster testing (set max_clades in config)
    max_clades = config.get("max_clades", None)
    if max_clades is not None and max_clades > 0:
        clades = clades[:max_clades]
    return clades


rule samples_by_clade:
    """Extract sample names for a specific clade."""
    input:
        metadata=rules.filter_metadata.output.filtered_metadata
    output:
        samples=os.path.join(config["output_dir"], "mat/clades/{clade}_samples.txt")
    log:
        os.path.join(config["output_dir"], "log/samples_by_clade_{clade}.log")
    params:
        clade="{clade}",
        clade_column=config.get("clade_column", "Nextstrain_clade")
    conda:
        "envs/default.yml"
    shell:
        """
        (
            echo "Extracting samples for clade: {params.clade}"
            zcat {input.metadata} | \
            awk -F'\\t' -v clade="{params.clade}" \
            'NR==1 {{for(i=1;i<=NF;i++) {{if($i=="strain") strcol=i; if($i=="{params.clade_column}") cladecol=i}}}}
             NR>1 && $cladecol ~ "^"clade"( |$)" {{print $strcol}}' > {output.samples}

            echo "Found $(wc -l < {output.samples}) samples for clade {params.clade}"
        ) > {log} 2>&1
        """


rule mat_clade_subset:
    """Extract mutation-annotated tree for a specific clade."""
    input:
        tree=get_final_tree(),
        samples=rules.samples_by_clade.output.samples
    output:
        tree=os.path.join(config["output_dir"], "mat/clades/{clade}_tree.pb")
    threads: get_threads("mat_clade_subset")
    resources:
        mem_mb=8000,
        runtime=60
    benchmark:
        os.path.join(config["output_dir"], "benchmarks/mat_clade_subset_{clade}.tsv")
    log:
        stderr=os.path.join(config["output_dir"], "log/mat_clade_subset_{clade}.stderr"),
        stdout=os.path.join(config["output_dir"], "log/mat_clade_subset_{clade}.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting clade subtree for {wildcards.clade}..." > {log.stdout}
        echo "Input tree: {input.tree}" >> {log.stdout}
        echo "Samples file: {input.samples}" >> {log.stdout}
        echo "Sample count: $(wc -l < {input.samples})" >> {log.stdout}

        (
            matUtils extract \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Clade subtree created: {output.tree}" >> {log.stdout}
        """


rule extract_pcps_by_clade:
    """Extract parent-child pairs from a clade-specific tree."""
    input:
        tree=rules.mat_clade_subset.output.tree,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        clade_founder_fasta=os.path.join(config["output_dir"], "clade_founders/{clade}.fa"),
        coding_sites=rules.ref_coding_sites.output.csv
    output:
        pcps=os.path.join(config["output_dir"], "mat/clades/{clade}_pcps_raw.csv")
    params:
        gene_region=config.get("pcp_gene_region", None),
        max_nt_mutations=config.get("pcp_max_nt_mutations", 4),
        max_reversions_to_ref=config.get("pcp_max_reversions_to_ref", 1),
        max_reversions_to_clade_founder=config.get("pcp_max_reversions_to_clade_founder", 1)
    threads: get_threads("extract_pcps")
    resources:
        mem_mb=8000,
        runtime=120
    benchmark:
        os.path.join(config["output_dir"], "benchmarks/extract_pcps_{clade}.tsv")
    log:
        os.path.join(config["output_dir"], "log/extract_pcps_{clade}.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/pcp_from_tree.py"


rule curate_pcps_by_clade:
    """Filter PCPs for a clade to remove invalid entries for DASM training."""
    input:
        pcps=rules.extract_pcps_by_clade.output.pcps
    output:
        curated_pcps=os.path.join(config["output_dir"], "pcps/{clade}_pcps.csv"),
        filtered_branches=os.path.join(config["output_dir"], "pcps/{clade}_filtered_branches.csv")
    log:
        os.path.join(config["output_dir"], "log/curate_pcps_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_by_clade.py"


rule aggregate_clade_pcps:
    """Aggregate all clade-specific PCPs into a single file."""
    input:
        pcps=lambda wc: expand(
            os.path.join(config["output_dir"], "pcps/{clade}_pcps.csv"),
            clade=clades_w_adequate_counts(wc)
        )
    output:
        all_pcps=os.path.join(config["output_dir"], "pcps/all_pcps.csv")
    log:
        os.path.join(config["output_dir"], "log/aggregate_clade_pcps.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_clade_pcps.py"


rule aggregate_filtered_branches:
    """Aggregate per-clade filtered branch IDs and create curation report."""
    input:
        curated_pcps=rules.aggregate_clade_pcps.output.all_pcps,
        raw_pcps=lambda wc: expand(
            os.path.join(config["output_dir"], "mat/clades/{clade}_pcps_raw.csv"),
            clade=clades_w_adequate_counts(wc)
        ),
        filtered_branches=lambda wc: expand(
            os.path.join(config["output_dir"], "pcps/{clade}_filtered_branches.csv"),
            clade=clades_w_adequate_counts(wc)
        )
    output:
        report=os.path.join(config["output_dir"], "pcps/pcp_curation_report.txt"),
        filtered_branches=os.path.join(config["output_dir"], "pcps/filtered_branch_ids.csv")
    log:
        os.path.join(config["output_dir"], "log/aggregate_filtered_branches.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/aggregate_filtered_branches.py"


