rule clade_founder_jsons:
    """Download clade founder JSON files from external sources."""
    params:
        neher_json=config["clade_founders"]["neher_json"],
        roemer_json=config["clade_founders"]["roemer_json"]
    output:
        neher_json=os.path.join(OUTDIR, "clade_founders/clade_founders_neher.json"),
        roemer_json=os.path.join(OUTDIR, "clade_founders/clade_founders_roemer.json")
    log:
        os.path.join(OUTDIR, "log/clade_founder_jsons.log")
    shell:
        """
        mkdir -p $(dirname {output.neher_json})
        echo "Downloading Neher clade founders..." > {log}
        curl -L {params.neher_json} > {output.neher_json} 2>> {log}
        echo "Downloading Roemer clade founders..." >> {log}
        curl -L {params.roemer_json} > {output.roemer_json} 2>> {log}
        echo "Done!" >> {log}
        """


rule clade_founder_fasta:
    """Generate the whole-genome founder FASTA for each clade.

    The per-gene, in-frame founder slices used as DASM wildtypes are produced
    separately by ``slice_founder_gene`` (which consumes this founder).
    """
    input:
        neher_json=rules.clade_founder_jsons.output.neher_json,
        roemer_json=rules.clade_founder_jsons.output.roemer_json,
        ref_fasta=rules.get_ref_fasta.output.ref_fasta
    output:
        fasta=CLADE_FOUNDER_FASTA
    params:
        roemer_nextstrain_to_pango=config.get("roemer_nextstrain_to_pango", {})
    log:
        os.path.join(OUTDIR, "log/clade_founder_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_founder_fasta.py"


# ---------------------------------------------------------------------------
# Gene-sliced founder FASTAs
# ---------------------------------------------------------------------------
#
# One in-frame founder slice is emitted per (gene, clade) at
# ``clade_founders/<gene>/<clade>.fa`` using the gene symbol verbatim. Each is
# sliced from that clade's whole-genome founder on the reference GTF's CDS
# blocks (via ``sequences.slice_cds``), so it byte-aligns with the PCP
# parent/child slices and can serve as the wildtype for training
# ParentIndependent DASM models. Fanning over a ``{gene}`` wildcard keeps the
# per-protein conditionality in the DAG rather than in a conditional output
# list on ``clade_founder_fasta`` (issue #95).

rule slice_founder_gene:
    """Slice one gene's in-frame CDS out of a clade's whole-genome founder."""
    input:
        fasta=rules.clade_founder_fasta.output.fasta,
        gtf=rules.edit_ref_gtf.output.gtf
    output:
        gene_fasta=os.path.join(OUTDIR, "clade_founders/{gene}/{clade}.fa")
    log:
        os.path.join(OUTDIR, "log/slice_founder_gene_{gene}_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/slice_founder_gene.py"


def _gene_founder_slices(wildcards):
    """Every adequate-count clade's founder slice for one gene."""
    return per_clade_inputs(
        os.path.join(OUTDIR, "clade_founders", wildcards.gene, "{clade}.fa"),
        wildcards,
    )


rule gene_founders_all_clades:
    """Collector target for one gene's per-clade founder slices.

    Aggregates every adequate-count clade's ``clade_founders/<gene>/<clade>.fa``
    into a single "everything is built" signal so ``rule all`` can depend on one
    path per gene.
    """
    input:
        _gene_founder_slices
    output:
        sentinel=os.path.join(OUTDIR, "clade_founders/{gene}/founders.done")
    shell:
        "touch {output.sentinel}"


