    script:
        "scripts/aggregate_filtered_branches.py"


# =============================================================================
# DASM-ready PCP curation
# =============================================================================
# These rules emit ``*_pcps_dasm_ready.csv.gz`` siblings of the existing
# ``*_pcps.csv.gz`` files. The filter set + train/val split mirrors
# ``dasm2 preprocess`` exactly (reimplemented in plain NumPy here so the
# rule can stay in ``envs/default.yml`` without pulling in torch/dasm2).
#
# Seed convention (mirrors ``data-central/scripts/filter_viral_pcps.sh``):
#   per-clade  -> seed=1729
#   aggregate  -> seed=42
# The aggregate's seed differs intentionally; it's a guardrail against
# accidentally producing the aggregate with the per-clade default.
#
# Once v2 ships, these outputs replace the post-hoc
# ``data-central/scripts/filter_viral_pcps.sh`` step.

rule curate_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to one clade's gene PCPs.

    Fanned over ``pcp_genes`` x clades: each protein's PCPs are filtered
    against that protein's own codon mask (``{gene}_codon_sites_to_mask.txt``).
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/{clade}_pcps.csv.gz"),
        mask_sites=os.path.join(OUTDIR, "{gene}_codon_sites_to_mask.txt")
    output:
        dasm_ready=os.path.join(OUTDIR, "pcps/{gene}/{clade}_pcps_dasm_ready.csv.gz"),
        report=os.path.join(OUTDIR, "pcps/{gene}/{clade}_dasm_filter_report.txt"),
        stats=os.path.join(OUTDIR, "pcps/{gene}/{clade}_dasm_filter_stats.json")
    params:
        seed=1729,
        val_fraction=0.10
    log:
        os.path.join(OUTDIR, "log/curate_pcps_for_dasm_{gene}_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


rule curate_all_pcps_for_dasm:
    """Apply DASM-ready filters and train/val split to the all-clades aggregate.

    Uses a different seed (42) than the per-clade rule (1729) by repository
    convention; this matches ``filter_viral_pcps.sh``'s guardrail.
    """
    input:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/all_pcps.csv.gz"),
        mask_sites=os.path.join(OUTDIR, "{gene}_codon_sites_to_mask.txt")
    output:
        dasm_ready=os.path.join(OUTDIR, "pcps/{gene}/all_pcps_dasm_ready.csv.gz"),
        report=os.path.join(OUTDIR, "pcps/{gene}/all_dasm_filter_report.txt"),
        stats=os.path.join(OUTDIR, "pcps/{gene}/all_dasm_filter_stats.json")
    params:
        seed=42,
        val_fraction=0.10
    log:
        os.path.join(OUTDIR, "log/curate_all_pcps_for_dasm_{gene}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/curate_pcps_for_dasm.py"


def _dasm_ready_per_clade_outputs(wildcards):
    """One gene's per-clade dasm-ready outputs - fans over clades_w_adequate_counts."""
    return expand(
        os.path.join(OUTDIR, "pcps", wildcards.gene, "{clade}_pcps_dasm_ready.csv.gz"),
        tree=wildcards.tree,
        clade=clades_w_adequate_counts(wildcards),
    )


rule dasm_ready_pcps_all_clades:
    """Collector target for one gene's per-clade DASM-ready outputs.

    Aggregates a gene's per-clade ``*_pcps_dasm_ready.csv.gz`` files into a single
    "everything is built" signal so ``rule all`` can depend on one path per gene.
    """
    input:
        _dasm_ready_per_clade_outputs
    output:
        sentinel=os.path.join(OUTDIR, "pcps/{gene}/dasm_ready_per_clade.done")
    shell:
        "touch {output.sentinel}"


