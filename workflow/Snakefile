# =============================================================================
# Date-cutoff PCP subtrees (#149)
# =============================================================================
# For each configured cutoff, the whole per-gene PCP family is rebuilt under
# ``pcps/{gene}/upto_{cutoff}/`` from the subtree of samples collected at or
# before that date -- a temporal holdout, so DASM can be trained on what was
# knowable then. Filenames inside the cutoff directory are *identical* to the
# full-tree ones, so a consumer points at a different root and its existing
# globbing works unchanged.
#
# These are parallel rules over the same scripts rather than a ``{cutoff}``
# wildcard threaded through the existing paths, matching how #137 added the
# per-era rate fits alongside the pooled ones. Threading the wildcard would move
# every existing PCP path and so break every current consumer for a purely
# additive feature.
#
# **The truncated PCPs are re-extracted, not filtered.** ``matUtils extract -s``
# returns the subtree *induced* on the retained samples, so internal nodes that
# lose all but one child are collapsed and their mutations merged onto the
# surviving branch. Row-filtering ``all_pcps.csv.gz`` would therefore keep PCPs
# whose parent is not reconstructible from the pre-cutoff samples at all, *and*
# drop every mutation on a branch whose child vanished -- leaving a set of
# parent-child pairs that is the branch set of no tree. Re-extraction also runs
# the same ``pcp_from_tree.py``, so there is no second implementation to drift.
#
# **Known leakage, stated rather than hidden.**
# ``pcps/{gene}/masked_nt_sites.csv``
# and ``pcps/{gene}/censored_mutations.csv`` are *not* recomputed per cutoff:
# they come from the full tree's count table and from
# ``data/usher_masked_sites.yaml``. A strict holdout would rebuild the mask from
# pre-cutoff data only, which means re-running the whole counting and GLM path
# per cutoff. The leak is confined to which sites are flagged as sequencing
# artifacts -- not to any fitness signal -- and the censor table is keyed by
# clade, so extra post-cutoff clades in it are inert for a consumer that looks
# masks up per clade. Documented in OUTPUT_SCHEMA.md.


checkpoint get_clades_by_cutoff:
    """Score every (cutoff, clade) pair, so inadequate ones can be skipped.

    A checkpoint because the result decides the DAG: a clade that does not exist
    yet at a cutoff, or that falls below ``min_clade_size`` there, gets no files
    at all rather than an empty PCP table that would look like a real one and
    read as a true zero everywhere downstream (#137's shape).

    Takes the per-clade sample lists as input rather than the metadata's clade
    column, so the clade vocabulary is by construction the one the full-tree path
    already uses -- and ``clades_to_exclude`` / ``max_clades`` come along for
    free, since those files exist only for clades the full tree processes.

    Depends on ``mat/node_dates.tsv`` because the selection drops samples whose
    reported and predicted dates contradict each other. That makes the cutoff
    path wait on the (multi-hour) dating rule, which the windowed path already
    does, and it means the cutoff sample sets move when the date prior moves --
    stated here because it is not otherwise obvious that changing
    ``chronumental_kwargs`` changes which PCPs exist.
    """
    input:
        metadata=rules.filter_metadata.output.filtered_metadata,
        node_dates=rules.chronumental.output.node_dates,
        samples=lambda wc: per_clade_inputs(
            os.path.join(OUTDIR, "mat/clades/{clade}_samples.txt"), wc
        )
    output:
        counts=os.path.join(OUTDIR, "mat/clade_counts_by_cutoff.csv")
    params:
        cutoffs=lambda wc: cutoffs_for_tree(wc.tree),
        min_clade_size=config.get("min_clade_size", 100),
        max_days_past_cutoff=PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF,
        clade_column=config.get("clade_column", "Nextstrain_clade")
    log:
        os.path.join(OUTDIR, "log/get_clades_by_cutoff.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/clade_counts_by_cutoff.py"


rule cutoff_pcp_summary:
    """Record which (cutoff, clade) pairs got truncated PCPs, and which did not.

    The roster half of the deliverable. A skipped clade contributes zero files,
    which in the output tree alone is indistinguishable from a wiring mistake,
    so the absence is written down -- and reconciled against the checkpoint in
    both directions, raising rather than reporting a disagreement (#149).
    """
    input:
        counts=rules.get_clades_by_cutoff.output.counts
    output:
        summary=os.path.join(OUTDIR, "pcps/cutoff_summary.csv")
    params:
        requested=_requested_clades_by_cutoff,
        genes=PCP_GENES
    log:
        os.path.join(OUTDIR, "log/cutoff_pcp_summary.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/cutoff_pcp_summary.py"


rule samples_upto_cutoff:
    """One clade's samples, restricted to those collected at or before a cutoff.

    Also drops samples whose reported and predicted dates disagree by more than
    ``pcp_max_predicted_days_past_cutoff``. Must stay in step with the checkpoint
    above: both go through ``cutoffs.select_for_cutoff``, so a filter applied in
    one and not the other cannot happen silently.
    """
    input:
        samples=rules.samples_by_clade.output.samples,
        metadata=rules.filter_metadata.output.filtered_metadata,
        node_dates=rules.chronumental.output.node_dates
    output:
        samples=os.path.join(OUTDIR, "mat/cutoffs/upto_{cutoff}/{clade}_samples.txt")
    params:
        max_days_past_cutoff=PCP_MAX_PREDICTED_DAYS_PAST_CUTOFF
    log:
        os.path.join(OUTDIR, "log/samples_upto_{cutoff}_{clade}.log")
    conda:
        "envs/default.yml"
    script:
        "scripts/samples_upto_cutoff.py"


rule mat_clade_subset_upto:
    """One clade's date-truncated subtree.

    Extracted from the **whole** filtered tree, not from
    ``mat/clades/{clade}_tree.pb``. Induced subtrees do compose, so the two
    routes should agree -- but the clade tree is itself already an induction, and
    resting a published output on that identity buys nothing here: the extraction
    costs about a minute either way, and reading this rule should not require the
    argument.
    """
    input:
        tree=get_final_tree(),
        samples=rules.samples_upto_cutoff.output.samples
    output:
        tree=os.path.join(OUTDIR, "mat/cutoffs/upto_{cutoff}/{clade}_tree.pb")
    threads: get_threads("mat_clade_subset")
    resources:
        # Measured: 104 benchmarks on the v12 gisaid tree peak at 25.0 GB,
        # median 23.3 GB, against a previous declaration of 8000. Like every
        # other `mem_mb` here this is inert -- production uses the local
        # executor with no `--resources` ceiling -- so it is a record of what
        # the rule costs rather than a limit, kept accurate for the same reason
        # as #146's chronumental correction: a number 3x under the real peak
        # reads as measured when it is not, and would over-subscribe whoever
        # first runs this under a scheduler that honours the request.
        #
        # The cost is a property of the *input tree*, not of how many samples
        # the clade keeps: `matUtils extract -s` loads the whole MAT before
        # pruning, and 21I at 8% of 21J's sample count measured slightly more.
        # So it does not fall as the cap falls.
        mem_mb=28000,
        runtime=60
    benchmark:
        os.path.join(OUTDIR, "benchmarks/mat_clade_subset_upto_{cutoff}_{clade}.tsv")
    log:
        stderr=os.path.join(OUTDIR, "log/mat_clade_subset_upto_{cutoff}_{clade}.stderr"),
        stdout=os.path.join(OUTDIR, "log/mat_clade_subset_upto_{cutoff}_{clade}.stdout")
    conda:
        "envs/usher.yml"
    shell:
        """
        echo "Extracting {wildcards.clade} subtree up to {wildcards.cutoff}..." > {log.stdout}
        echo "Sample count: $(wc -l < {input.samples})" >> {log.stdout}

        (
            matUtils extract \
                -T {threads} \
                -i {input.tree} \
                -s {input.samples} \
                -o {output.tree}
        ) >> {log.stdout} 2>> {log.stderr}

        echo "Cutoff subtree created: {output.tree}" >> {log.stdout}
        """


rule extract_pcps_by_clade_upto:
    """Extract and curate PCPs from one clade's date-truncated subtree.

    The same ``pcp_from_tree.py`` as the full-tree path, with the same params --
    the only difference is the tree it is handed. Clade founders are deliberately
    *not* recomputed per cutoff: a clade's founder is a property of the clade's
    defining mutations, not of which of its samples have been collected yet.
    """
    input:
        tree=rules.mat_clade_subset_upto.output.tree,
        gtf=rules.edit_ref_gtf.output.gtf,
        fasta=rules.get_ref_fasta.output.ref_fasta,
        clade_founder_fasta=CLADE_FOUNDER_FASTA,
        coding_sites=rules.ref_coding_sites.output.csv
    output:
        pcps=os.path.join(OUTDIR, "pcps/{gene}/upto_{cutoff}/{clade}_pcps.csv.gz"),
        filtered_branches=os.path.join(
            OUTDIR, "pcps/{gene}/upto_{cutoff}/{clade}_filtered_branches.csv"
        )
    params:
        max_nt_mutations=config["max_nt_mutations"],
        max_reversions_to_ref=config["max_reversions_to_ref"],
        max_reversions_to_clade_founder=config["max_reversions_to_clade_founder"],
        pcp_gene_cds_blocks=PCP_GENE_CDS_BLOCKS
    threads: get_threads("extract_pcps")
    resources:
        # Measured on the v12 gisaid tree over the 422 full-tree benchmarks of
        # this rule and `extract_pcps_by_clade_upto` pooled (197 + 225; both
        # share this declaration, so both are counted): 482 MB median to
        # 77.3 GB for ORF1a/21J, a 160x spread, because peak cost tracks the
        # clade's subtree and the gene's CDS length together -- ORF1a peaks at
        # 230-277x its input .pb, S near 108x. A flat 8000 under-granted 59 of
        # those 422 and 12 exceeded 32 GB, while a flat value covering the tail
        # (80000) would cap a 995 GB box at 12 concurrent jobs whose median
        # need is under 500 MB. Scaling on input size instead leaves the small
        # jobs small; `attempt` is the safety net for a tree outside the
        # measured envelope.
        #
        # **The floor, not the multiplier, is what most jobs get, so it is
        # sized against the #151 arms rather than the full tree.** 307 of the
        # 449 checkable full-tree jobs are floor-bound, and *all 684* arm jobs
        # are: thinning shrinks a clade's `.pb` without shrinking its PCP
        # expansion proportionally, so an arm's peak/input runs to 737x against
        # ORF1a's 230-277x at full depth -- `cap_50000_0` ORF1a/21J peaks at
        # 5304 MB from an 8.4 MB subtree. A floor of 4000 therefore under-
        # granted 2 of 684 arm jobs while under-granting none of the full-tree
        # ones, which is exactly the population a root-only census cannot see.
        # 6000 gives zero under-grants across all 1133 checkable jobs. The 225
        # `_upto` pairs stay unverifiable because `mat/cutoffs/*.pb` is
        # `temp()`; the peak among them (77347 MB) is within 17 MB of its
        # verified full-tree twin.
        #
        # Like every other `mem_mb` here this is inert under the local executor
        # -- it records what the rule costs rather than limiting it.
        mem_mb=lambda wildcards, input, attempt: max(
            6000, int(300 * input.size_mb)
        ) * attempt,
        runtime=120
    benchmark:
        os.path.join(
            OUTDIR, "benchmarks/extract_pcps_{gene}_upto_{cutoff}_{clade}.tsv"
        )
    log:
        os.path.join(OUTDIR, "log/extract_pcps_{gene}_upto_{cutoff}_{clade}.log")
    conda:
        "envs/bte.yml"
    script:
        "scripts/pcp_from_tree.py"


