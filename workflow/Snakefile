"""Top-level Snakemake file that runs the unified MAT pipeline."""

import os
import pandas as pd
import yaml

configfile: "config/config.yaml"


# =============================================================================
# Version Management
# =============================================================================

# Read pipeline version from VERSION file
VERSION_FILE = os.path.join(workflow.basedir, "..", "VERSION")
with open(VERSION_FILE) as f:
    PIPELINE_VERSION = f.read().strip()

# Append version to output_dir if not already present
output_dir = config["output_dir"]
if not output_dir.endswith(f"_{PIPELINE_VERSION}"):
    config["output_dir"] = f"{output_dir}_{PIPELINE_VERSION}"
    print(f"Pipeline version {PIPELINE_VERSION}: Output directory set to {config['output_dir']}")


# =============================================================================
# Config Validation
# =============================================================================

# Required configuration parameters
REQUIRED_CONFIG_PARAMS = [
    "mat",
    "metadata",
    "output_dir",
    "clade_column",
    "ref_fasta",
    "ref_gtf",
    "max_nt_mutations",
    "max_reversions_to_ref",
    "site_include_range",
    "qc_filter_options",
    "min_clade_size",
]

# Parameters required for full pipeline (may not be present in test mode)
OPTIONAL_CONFIG_PARAMS = [
    "site_mask_vcf",
    "usher_masked_sites",
    "max_reversions_to_clade_founder",
    "clade_founders",
]

missing_params = [p for p in REQUIRED_CONFIG_PARAMS if p not in config]
if missing_params:
    raise ValueError(
        f"Missing required config parameters: {missing_params}\n"
        f"Please add these to your config.yaml file."
    )


# =============================================================================
# Wildcard Constraints
# =============================================================================

wildcard_constraints:
    clade="[A-Za-z0-9_.+-]+",  # Valid clade name characters


# =============================================================================
# Default Resources
# =============================================================================

# Default resource allocations (can be overridden per-rule)
default_resources = {
    "mem_mb": 4000,
    "runtime": 60,  # minutes
}


# =============================================================================
# Helper Functions
# =============================================================================

def get_threads(rule_name):
    """Get thread count for a rule from config with fallback to default."""
    if "threads" in config and rule_name in config["threads"]:
        return config["threads"][rule_name]
    elif "threads" in config and "default" in config["threads"]:
        return config["threads"]["default"]
    return 1


def get_final_tree():
    """Get the final tree path based on whether optimization is enabled."""
    output_dir = config["output_dir"]
    if config.get("optimize_tree", False):
        return f"{output_dir}/mat/filtered_tree.pb"
    return f"{output_dir}/mat/filtered_tree_raw.pb"


