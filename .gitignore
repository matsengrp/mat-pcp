
.DS_Store
pixi.lock

**/_ignore/
.snakemake
**/__pycache__/

# Data directory (except specific files to track)
data/*
!data/usher_masked_sites.yaml
!data/lan_2022/
data/lan_2022/*
!data/lan_2022/41467_2022_28603_MOESM11_ESM.txt
!data/test_data/
data/test_data/*
!data/test_data/*.gz
!data/test_data/*.json

# Results and archives (not version controlled)
results/
results_*/
archives/
!archives/README.md

# Documentation artifacts
docs/dag_max1_wide.svg
docs/dag_max2_wide.svg
docs/issues/

# One-off test scripts
workflow/scripts/test_v2_regression.py

# bip epic orchestration (local only)
.epic-config.json
.epic-status.json
.epic-worklog.md
.epic-notifications.log

# Local issue drafts; GitHub holds the canonical text
ISSUE-*.md

# Production-run transcripts. Disposable: how a release was run is recorded in
# CHANGELOG.md and the release PR, not in a log at the repo root. New runs write
# into log/ rather than here.
log/
run-*.log
run-*.exit

# marimo notebook session cache (analysis/ notebooks)
**/__marimo__/

# Local production-run driver logs (multi-MB, machine-specific).
logs/
